--!strict
-- Spawn formulas as pure functions (DESIGN.md section 7). Since 2026-11-09 the waves follow Brotato 1.2.0.1's own
-- spawn data (Config.EnemyWaves, generated by tools/build-enemy-waves.py) and the rules of its wave manager and
-- entity spawner: which groups a wave runs (danger, wave limits, hordes, elite waves), when each fires and repeats
-- (checked once per whole second), how many enemies a unit brings (co-op, Enemies stat, Trees stat, chance rest),
-- where a group and its enemies land (anywhere, in an area, at the arena edge, away from players) and the enemy
-- maximum (100 + 1/8 per extra player, extra enemies are removed when a group fires). Also HP and damage growth per
-- wave, the ring used by debug and item spawns and the old elite times. Used by SpawnDirector and BossService;
-- tested in tests/SpawnRules.spec.luau. `minutes` is schedule time (RunSchedule.minutesAt): one minute per wave.

local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local EnemyStats = require(Shared.Util.EnemyStats)
local RunSchedule = require(Shared.Util.RunSchedule)

export type Rect = { minX: number, maxX: number, minZ: number, maxZ: number }
export type Circle = { x: number, z: number, radius: number }
export type Group = typeof(Config.EnemyWaves.waves[1].groups[1])
export type Unit = typeof(Config.EnemyWaves.waves[1].groups[1].units[1])

-- One group of a running wave: when it fires next (seconds into the wave) and how often it still repeats.
export type Timer = {
	group: Group,
	started: boolean, -- fired (or rolled and missed) its first time
	repeatsLeft: number,
	interval: number,
	nextAt: number,
}

local Spawn = Config.Run.spawn
local Waves = Config.EnemyWaves
local Layout = Spawn.layout

local SpawnRules = {}

-- Co-op factors (Brotato's CoopService): enemies per group, enemy HP and enemy damage grow per extra player.
function SpawnRules.coopEnemies(playerCount: number): number
	return (math.max(playerCount, 1) - 1) * Waves.coop.enemiesPerPlayer
end

function SpawnRules.coopHealth(playerCount: number): number
	return math.max(0.01, 1 + (math.max(playerCount, 1) - 1) * Waves.coop.healthPerPlayer)
end

function SpawnRules.coopDamage(playerCount: number): number
	return math.max(0.01, 1 + (math.max(playerCount, 1) - 1) * Waves.coop.damagePerPlayer)
end

-- The run's waves with spawn data; endless waves run the last one's groups.
local function waveData(wave: number)
	return Waves.waves[math.clamp(math.floor(wave), 1, #Waves.waves)]
end

-- Enemy maximum of `wave` (Brotato: max_enemies + (players - 1) * max_enemies / 8, whole enemies). When a group
-- fires with more regular enemies alive, random ones are removed without loot.
function SpawnRules.cap(playerCount: number, wave: number?): number
	local base = waveData(wave or 1).maxEnemies
	return math.floor(base + (math.max(playerCount, 1) - 1) * base * Spawn.cap.perExtraPlayerShare)
end

-- The wave (1 for the first) running at schedule minute `minutes`.
function SpawnRules.waveAt(minutes: number): number
	return math.clamp(math.floor(minutes) + 1, 1, #Waves.waves)
end

-- B11: the run's wave at schedule minute `minutes`, also past the last one (endless mode; waveAt stops at the last).
function SpawnRules.runWave(minutes: number): number
	return math.max(math.floor(minutes) + 1, 1)
end

-- Growth steps of `wave` from a list of steps per wave; past the list (endless mode, B11) the last step's increase
-- goes on per wave.
function SpawnRules.step(steps: { number }, wave: number): number
	local count = #steps
	if wave <= count then
		return steps[math.max(wave, 1)]
	end
	return steps[count] + (steps[count] - steps[count - 1]) * (wave - count)
end

-- Multipliers before danger: base + increment * (wave - 1), independently for HP, contact and shots.
function SpawnRules.growth(enemyId: string, wave: number): (number, number, number)
	local kind = Config.Enemies.types[enemyId] or Config.Enemies.champions[enemyId] -- champions grow too (WP10)
	if not kind then
		return 1, 1, 1
	end
	return EnemyStats.growth(kind, wave)
end

-- True if `group` takes part in `wave` on danger level `danger` (Brotato's min/max difficulty and wave, and the
-- groups that stay away in horde or elite waves). Boss groups are BossService's.
function SpawnRules.runs(group: Group, wave: number, danger: number, horde: boolean, elite: boolean): boolean
	if group.boss then
		return false
	end
	if (group.preventIfHorde and horde) or (group.preventIfElite and elite) then
		return false
	end
	return danger >= group.minDanger and danger <= group.maxDanger and wave >= group.minWave and wave <= group.maxWave
end

-- The groups `wave` runs: its own, those of every wave (Tree, Looter, Gobbler) and, in a horde wave, the horde
-- groups (in that order, like Brotato's wave manager adds them).
function SpawnRules.groupsFor(wave: number, danger: number, horde: boolean?, elite: boolean?): { Group }
	local list = {}
	local isHorde, isElite = horde == true, elite == true
	local function add(groups: { Group })
		for _, group in groups do
			if SpawnRules.runs(group, wave, danger, isHorde, isElite) then
				table.insert(list, group)
			end
		end
	end
	add(waveData(wave).groups)
	add(Waves.allWaves)
	if isHorde then
		add(Waves.horde)
	end
	return list
end

-- The groups at schedule minute `minutes` on danger level `danger` (nil = 5) outside horde and elite waves.
function SpawnRules.groupsAt(minutes: number, danger: number?): { Group }
	return SpawnRules.groupsFor(SpawnRules.waveAt(minutes), danger or #Config.Difficulty.levels - 1)
end

-- A fresh timer for every group of a wave.
function SpawnRules.newTimers(groups: { Group }): { Timer }
	local timers = {}
	for _, group in groups do
		table.insert(timers, {
			group = group,
			started = false,
			repeatsLeft = group.repeating,
			interval = group.interval,
			nextAt = math.huge,
		})
	end
	return timers
end

-- Brotato's wave manager at the check of whole second `second` of the wave: a group not started yet starts once
-- second >= timing (it fires if `roll()` < its chance; with repeats it is due again at timing + interval either
-- way); a repeating group fires once its time is reached, then its interval shrinks by reduceInterval (at least
-- minInterval) and the next time moves on by the new interval. Returns the groups firing, in timer order.
function SpawnRules.due(timers: { Timer }, second: number, roll: () -> number): { Group }
	local firing = {}
	for _, timer in timers do
		local group = timer.group
		if not timer.started then
			if group.timing <= second then
				timer.started = true
				if roll() < group.chance then
					table.insert(firing, group)
				end
				if group.repeating > 0 then
					timer.nextAt = group.timing + group.interval
				end
			end
		elseif timer.repeatsLeft > 0 and second >= timer.nextAt then
			table.insert(firing, group)
			timer.repeatsLeft -= 1
			timer.interval = math.max(group.minInterval, timer.interval - group.reduceInterval)
			timer.nextAt += timer.interval
		end
	end
	return firing
end

-- Enemies (or trees) one unit of a firing group brings (Brotato's entity spawner): a whole number from min to max,
-- for enemies of non-loot groups plus the co-op share and then the Enemies stat (at least 1), for trees plus the
-- Trees stat; times the unit's chance, the fraction becomes one more with that chance. `countShare` is the Enemy
-- count slider (1 = 100 %, our own accessibility option). `rollNumber` and `rollRest` are in [0, 1).
function SpawnRules.unitCount(
	unit: Unit,
	group: Group,
	playerCount: number,
	enemiesStat: number,
	treesStat: number,
	countShare: number,
	rollNumber: number,
	rollRest: number
): number
	local number = unit.min + math.min(math.floor(rollNumber * (unit.max - unit.min + 1)), unit.max - unit.min)
	if unit.neutral then
		number += treesStat
	elseif not group.loot then
		number += number * SpawnRules.coopEnemies(playerCount)
		number = math.max(1, number + number * enemiesStat / 100) * countShare
	end
	local total = number * unit.chance
	local whole = math.floor(total)
	return if rollRest < total - whole then whole + 1 else whole
end

-- Brotato pixels turned into studs.
function SpawnRules.studs(pixels: number): number
	return pixels * Layout.studsPerPixel
end

-- Squared distance from (x, z) to the closest of `players` (x/z pairs), huge without players.
function SpawnRules.closestSquared(players: { Vector3 }, x: number, z: number): number
	local best = math.huge
	for _, position in players do
		local dx, dz = position.X - x, position.Z - z
		best = math.min(best, dx * dx + dz * dz)
	end
	return best
end

-- A random point anywhere in the arena, `margin` studs from its walls (Brotato's random zone position).
function SpawnRules.anywhere(random: () -> number, bounds: Rect, margin: number?): (number, number)
	local m = margin or 0
	return bounds.minX + m + random() * (bounds.maxX - bounds.minX - 2 * m),
		bounds.minZ + m + random() * (bounds.maxZ - bounds.minZ - 2 * m)
end

-- A random point on one of the four arena sides, edgeDistance in from the wall (Brotato's edge-of-map spawns).
function SpawnRules.edgePoint(random: () -> number, bounds: Rect): (number, number)
	local inset = SpawnRules.studs(Layout.edgeDistance)
	local side = math.min(math.floor(random() * 4), 3)
	local along = random()
	if side == 0 then -- top
		return bounds.minX + inset + along * (bounds.maxX - bounds.minX - 2 * inset), bounds.minZ + inset
	elseif side == 1 then -- left
		return bounds.minX + inset, bounds.minZ + inset + along * (bounds.maxZ - bounds.minZ - 2 * inset)
	elseif side == 2 then -- bottom
		return bounds.minX + inset + along * (bounds.maxX - bounds.minX - 2 * inset), bounds.maxZ - inset
	end
	return bounds.maxX - inset, bounds.minZ + inset + along * (bounds.maxZ - bounds.minZ - 2 * inset) -- right
end

-- A random point in the square of side `area` studs around (x, z), the square pushed inside the arena first
-- (edgeDistance from the walls; Brotato's random position in an area).
function SpawnRules.inArea(random: () -> number, bounds: Rect, x: number, z: number, area: number): (number, number)
	local inset = SpawnRules.studs(Layout.edgeDistance) + area / 2
	local cx = math.clamp(x, bounds.minX + inset, math.max(bounds.minX + inset, bounds.maxX - inset))
	local cz = math.clamp(z, bounds.minZ + inset, math.max(bounds.minZ + inset, bounds.maxZ - inset))
	return cx + (random() - 0.5) * area, cz + (random() - 0.5) * area
end

-- Where one enemy of `group` lands around the group's spot (gx, gz): at an edge, in its area or anywhere.
function SpawnRules.unitPoint(
	random: () -> number,
	bounds: Rect,
	group: Group,
	gx: number,
	gz: number
): (number, number)
	if group.edge then
		return SpawnRules.edgePoint(random, bounds)
	elseif group.area < 0 then
		return SpawnRules.anywhere(random, bounds, SpawnRules.studs(group.edgeMargin))
	end
	return SpawnRules.inArea(random, bounds, gx, gz, SpawnRules.studs(group.area))
end

-- Brotato's "away from players" loop: draws new points while the closest player is nearer than the required
-- distance, which shrinks by distanceStep per try down to minDistanceFloor (then the last point stays).
local function awayFromPlayers(
	players: { Vector3 },
	x: number,
	z: number,
	minPixels: number,
	draw: () -> (number, number)
): (number, number)
	local required = minPixels
	while true do
		local distance = SpawnRules.studs(required)
		if SpawnRules.closestSquared(players, x, z) >= distance * distance then
			break
		end
		x, z = draw()
		required = math.max(Layout.minDistanceFloor, required - Layout.distanceStep)
		if required == Layout.minDistanceFloor then
			break
		end
	end
	return x, z
end

-- The spot of a firing group: anywhere in the arena, at least minPlayerDistance + area / 2 pixels (at most half the
-- arena's longer side) from every player.
function SpawnRules.groupPoint(random: () -> number, bounds: Rect, group: Group, players: { Vector3 }): (number, number)
	local halfSide = math.max(bounds.maxX - bounds.minX, bounds.maxZ - bounds.minZ) / 2 / Layout.studsPerPixel
	local required = math.floor(math.min(Layout.minPlayerDistance + group.area / 2, halfSide))
	local function draw()
		return SpawnRules.anywhere(random, bounds)
	end
	local x, z = draw()
	return awayFromPlayers(players, x, z, required, draw)
end

-- The spot of one enemy of `unit` in `group` around the group's spot, at least minPlayerDistance plus the unit's
-- extra distance from every player.
function SpawnRules.enemyPoint(
	random: () -> number,
	bounds: Rect,
	group: Group,
	unit: Unit,
	gx: number,
	gz: number,
	players: { Vector3 }
): (number, number)
	local function draw()
		return SpawnRules.unitPoint(random, bounds, group, gx, gz)
	end
	local x, z = draw()
	return awayFromPlayers(players, x, z, math.floor(Layout.minPlayerDistance + unit.extraDistance), draw)
end

-- Enemies the spawn queue lets out per spawn step (Brotato: one, up to burstMax while the queue is long).
function SpawnRules.queueBurst(queued: number): number
	local queue = Spawn.queue
	if queued < queue.limit then
		return 1
	end
	return math.floor(math.clamp((queued - queue.limit) / queue.burstDivisor, 1, queue.burstMax))
end

local mixes: { [any]: { [string]: number } } = {}

-- Brotato's every-wave and horde groups (trees, Looter, Gobbler, horde crowds) stay out of the debug mix.
local special: { [any]: boolean } = {}
for _, list in { Waves.allWaves, Waves.horde } do
	for _, group in list do
		special[group] = true
	end
end

-- The kinds of the groups running at this minute, weighted by enemies per second (Gloom Elites, debug waves).
function SpawnRules.mixAt(minutes: number, danger: number?): { [string]: number }
	local groups = SpawnRules.groupsAt(minutes, danger)
	local weights = mixes[groups]
	if not weights then
		weights = {}
		for _, group in groups do
			if group.neutral or group.loot or special[group] then
				continue
			end
			for _, unit in group.units do
				if unit.enemy and not unit.neutral then
					local each = (unit.min + unit.max) / 2 * unit.chance / math.max(group.interval, 1)
					weights[unit.enemy] = (weights[unit.enemy] or 0) + each
				end
			end
		end
		mixes[groups] = weights
	end
	return weights
end

-- Elites called in (from, to] (Run.spawn.elites).
function SpawnRules.elitesDue(from: number, to: number): number
	return RunSchedule.elitesDue(from, to)
end

-- True if elites spawning at this minute get a random affix.
function SpawnRules.affixesAt(minutes: number): boolean
	return minutes >= Spawn.elites.affixFromMinute
end

local sortedKeys: { [any]: { string } } = {}

-- Picks an enemy id from weights with roll in [0, 1). Keys are walked in sorted order, so the same roll
-- always gives the same enemy.
function SpawnRules.pickEnemy(weights: { [string]: number }, roll: number): string
	local keys = sortedKeys[weights]
	if not keys then
		keys = {}
		for key in weights do
			table.insert(keys, key)
		end
		table.sort(keys)
		sortedKeys[weights] = keys
	end
	local total = 0
	for _, key in keys do
		total += weights[key]
	end
	local threshold = roll * total
	local sum = 0
	for _, key in keys do
		sum += weights[key]
		if threshold < sum then
			return key
		end
	end
	return keys[#keys]
end

-- True if a body of `radius` at (x, z) lies inside the rectangle and outside every obstacle.
function SpawnRules.isFree(x: number, z: number, radius: number, bounds: Rect, obstacles: { Circle }): boolean
	if x - radius < bounds.minX or x + radius > bounds.maxX or z - radius < bounds.minZ or z + radius > bounds.maxZ then
		return false
	end
	for _, obstacle in obstacles do
		local reach = obstacle.radius + radius
		if (x - obstacle.x) ^ 2 + (z - obstacle.z) ^ 2 < reach * reach then
			return false
		end
	end
	return true
end

-- A point inside the arena and outside every obstacle for a body of `radius`: (x, z) itself, else pushed in from
-- the walls and out of obstacles.
function SpawnRules.settle(x: number, z: number, radius: number, bounds: Rect, obstacles: { Circle }): (number, number)
	x = math.clamp(x, bounds.minX + radius, bounds.maxX - radius)
	z = math.clamp(z, bounds.minZ + radius, bounds.maxZ - radius)
	for _, obstacle in obstacles do
		local dx, dz = x - obstacle.x, z - obstacle.z
		local reach = obstacle.radius + radius
		local squared = dx * dx + dz * dz
		if squared < reach * reach then
			local length = math.sqrt(squared)
			if length < 1e-3 then
				dx, dz, length = 1, 0, 1
			end
			x, z = obstacle.x + dx / length * reach, obstacle.z + dz / length * reach
		end
	end
	return x, z
end

-- A free spot on the ring ringMin..ringMax around (centerX, centerZ), trying up to `tries` random points (debug
-- spawns). `random` returns numbers in [0, 1). Returns nil when every try hit a wall or an obstacle.
function SpawnRules.findSpawnPoint(
	random: () -> number,
	centerX: number,
	centerZ: number,
	radius: number,
	bounds: Rect,
	obstacles: { Circle },
	tries: number
): (number?, number?)
	for _ = 1, tries do
		local angle = random() * 2 * math.pi
		local distance = Spawn.ringMin + random() * (Spawn.ringMax - Spawn.ringMin)
		local x, z = centerX + math.cos(angle) * distance, centerZ + math.sin(angle) * distance
		if SpawnRules.isFree(x, z, radius, bounds, obstacles) then
			return x, z
		end
	end
	return nil, nil
end

return SpawnRules
