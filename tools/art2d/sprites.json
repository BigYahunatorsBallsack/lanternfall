 "enemies": {
  "title": "Gegner",
  "pixels": 512,
  "items": {
   "Shadeling": {
    "text": "Kleiner Standard-Gegner, läuft stumpf auf den Spieler zu. Muss bei großer Menge gut lesbar sein."
   },
   "Stalker": {
    "text": "Schneller, dünner Verwandter des Shadeling."
   },
   "AbyssShadeling": {
    "text": "Dunklere, gefährlichere Variante des Shadeling."
   },
   "Brute": {
    "text": "Groß, schwer, langsam, viel Masse."
   },
   "AbyssBrute": {
    "text": "Dunklere, gefährlichere Variante des Brute."
   },
   "Thornback": {
    "text": "Massig, mit Stacheln auf dem Rücken; wirft Stacheln zurück, wenn man ihn trifft."
   },
   "Spitter": {
    "text": "Bleibt auf Abstand und spuckt Geschosse, großer Mund."
   },
   "Skulker": {
    "text": "Hinterhältiger Schütze, duckt sich, flieht vor dem Spieler."
   },
   "Herald": {
    "text": "Unterstützer, stärkt andere Gegner: Horn oder Fahne, goldene Akzente."
   },
   "Mender": {
    "text": "Heiler, heilt andere Gegner: grüne Akzente, freundlich-unheimlich."
   },
   "Charger": {
    "text": "Stürmt in gerader Linie: gesenkter Kopf, Hörner, vorgebeugt."
   },
   "Reaper": {
    "text": "Schlägt im Halbkreis zu: lange Klingenarme."
   },
   "Splitter": {
    "text": "Rund und prall, zerplatzt beim Tod in kleine Splitlinge."
   },
   "Splitling": {
    "text": "Winziger Rest des Splitter, gleiche Farbe."
   },
   "BroodEgg": {
    "text": "Unbewegliches Ei, aus dem Gegner schlüpfen. Kein Gesicht nötig."
   },
   "Looter": {
    "text": "Flieht mit einem Beutel auf dem Rücken, lässt beim Tod eine Kiste fallen."
   },
   "Gobbler": {
    "text": "Frisst herumliegende Beute: riesiger Mund, runder Bauch."
   },
   "Tree": {
    "text": "Kleiner Baum, steht still und lässt Früchte fallen. Dicker Stamm, runde Krone."
   },
   "LanternEater": {
    "text": "Boss. Riesiges Raubtier, jagt und stürmt, glühender Bauch."
   },
   "HollowSeer": {
    "text": "Boss. Schwebende Gestalt mit großem leuchtendem Auge, wirkt Magie."
   },
   "BrassRam": {
    "text": "Champion. Messing-Widder, stürmt und prallt von Wänden ab."
   },
   "Flayer": {
    "text": "Champion. Hager mit langen Krallen."
   },
   "Abbot": {
    "text": "Champion. Kuttenträger mit Kapuze, schnell."
   },
   "MireJaw": {
    "text": "Champion. Sumpfwesen, vor allem Maul."
   },
   "Monolith": {
    "text": "Champion. Lebender Steinblock."
   },
   "SickleWraith": {
    "text": "Champion. Schwebender Geist mit zwei Sicheln."
   },
   "BroodMatron": {
    "text": "Champion. Dicke Mutter-Kreatur mit Eiern am Körper."
   },
   "StoneSeraph": {
    "text": "Champion. Engel aus Stein mit Flügeln."
   }
  }
