--!strict
-- Full native starts, source mechanics and personal challenge boundaries through production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Loud")
local Shop = require(f.S.ShopService)
describe("Native Loud package", function()
	it("runs all38 original starts", function()
		f.starts(38)
	end)
	it("subtracts three Harvesting before payout and growth only on completed waves", function()
		f.start("WatchmanPistol")
		expect(f.Stats.getStat(f.me, "damage")).toBe(30)
		expect(f.Stats.getStat(f.me, "enemyCount")).toBe(50)
		f.Stats.addStats(f.me, { harvesting = 10 })
		Shop.addShards(f.me, 100 - Shop.getShards(f.me))
		local peerWallet = Shop.getShards(f.peer)
		f.nextWave()
		expect(Shop.getShards(f.me)).toBe(107)
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(8)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(8)
		f.Run.skipTo(require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt)
		f.world.advance(0.1)
		expect(Shop.getShards(f.me)).toBe(112)
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(6)
		expect(Shop.getShards(f.peer)).toBe(peerWallet)
	end)
	it("opens at5000 personal lifetime kills", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).nativeCounts.enemiesKilled = 4999
		expect(A.characterUnlocked(f.Data.get(f.peer), "Loud")).toBe(false)
		f.Data.observeNativeEnemyKill(f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Loud")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
