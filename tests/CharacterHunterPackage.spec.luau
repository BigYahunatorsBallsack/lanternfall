--!strict
-- Native starting alternatives, personal production-service rules and original challenge boundary.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("FarSeer")
describe("Native Hunter package", function()
	it("adopts all20 native starts while retaining FarSeer", function()
		expect(f.wasLegacy).toBe(true)
		expect(f.class.displayName).toBe("Hunter")
		f.starts(20)
	end)
	it("uses actual Range conversions and original crit/HP/Harvesting gains", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "range")).toBe(100)
		expect(f.Stats.getStat(f.me, "damage")).toBe(10)
		expect(f.Stats.getStat(f.me, "maxHp")).toBeNear(6.7)
		f.Stats.addStats(f.me, { range = 19, critChance = 4, maxHp = 10, harvesting = 10 })
		expect(f.Stats.getStat(f.me, "damage")).toBe(11)
		expect(f.Stats.getStat(f.me, "critChance")).toBe(5)
		expect(f.Stats.getStat(f.me, "maxHp")).toBeNear(13.4)
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(0)
		f.Stats.setDynamic(f.me, { range = 11 })
		expect(f.Stats.getStat(f.me, "damage")).toBe(13)
		f.Stats.setDynamic(f.me, {})
		expect(f.Stats.getStat(f.me, "damage")).toBe(11)
		expect(f.Stats.getStat(f.peer, "damage")).toBe(0)
	end)
	it("opens personally at300Range and retains the challenge after the stat falls", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Stats.addStats(f.peer, { range = 299 - f.Stats.getStat(f.peer, "range") })
		expect(A.characterUnlocked(f.Data.get(f.peer), "FarSeer")).toBe(false)
		f.Stats.addStats(f.peer, { range = 1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "FarSeer")).toBe(true)
		f.Stats.addStats(f.peer, { range = -10 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "FarSeer")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
