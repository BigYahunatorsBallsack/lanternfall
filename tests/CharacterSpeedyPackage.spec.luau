--!strict
-- Full native starts, source mechanics and personal challenge boundaries through production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Speedy")
describe("Native Speedy package", function()
	it("runs all21 original starts", function()
		f.starts(21)
	end)
	it("applies stationary armor immediately and converts current Speed toward zero", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "speed")).toBe(30)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(15)
		expect(f.Stats.getStat(f.me, "armor")).toBe(-103)
		f.world.fireServerAs(f.me, "SetMovementIntent", true)
		expect(f.Stats.getStat(f.me, "armor")).toBe(-3)
		f.world.fireServerAs(f.me, "SetMovementIntent", false)
		expect(f.Stats.getStat(f.me, "armor")).toBe(-103)
		f.Stats.addStats(f.me, { speed = -35 })
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(-2)
		f.Stats.setDynamic(f.me, { speed = 11 })
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(3)
		f.Stats.setDynamic(f.me, {})
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(-2)
		expect(f.Stats.getStat(f.peer, "armor")).toBe(0)
	end)
	it("opens permanently at50 personal Speed", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Stats.addStats(f.peer, { speed = 49 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Speedy")).toBe(false)
		f.Stats.addStats(f.peer, { speed = 1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Speedy")).toBe(true)
		f.Stats.addStats(f.peer, { speed = -1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Speedy")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
