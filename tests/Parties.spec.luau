-- Unit tests for the party rules of a hub server (Services/PartyService/Parties, Paket 15): invites, accept and
-- decline, a full party, leave and kick, the next leader, expiring invites and putting a party back together after
-- the run place.

local ServerScriptService = game:GetService("ServerScriptService")
local Parties = require(ServerScriptService.Server.Services.PartyService.Parties)

local SECONDS = 30

describe("invites", function()
	it("makes a party when the first invite is accepted", function()
		local book = Parties.new(4)
		expect((book:invite(1, 2, 0, SECONDS))).toBe(true)
		expect(book:inviteTo(2).from).toBe(1)
		expect(book:get(1)).toBe(nil) -- no party before the answer
		expect((book:answer(2, 1, true))).toBe(true)
		expect(book:leaderOf(2)).toBe(1)
		local members = book:membersOf(2)
		expect(#members).toBe(2)
		expect(members[1]).toBe(1)
		expect(book:inviteTo(2)).toBe(nil)
	end)

	it("declines, refuses self invites and invites from members", function()
		local book = Parties.new(4)
		book:invite(1, 2, 0, SECONDS)
		expect((book:answer(2, 1, false))).toBe(true)
		expect(book:get(2)).toBe(nil)
		expect(select(2, book:answer(2, 1, true))).toBe("NoInvite")
		expect(select(2, book:invite(1, 1, 0, SECONDS))).toBe("Self")
		book:invite(1, 2, 0, SECONDS)
		book:answer(2, 1, true)
		expect(select(2, book:invite(2, 3, 0, SECONDS))).toBe("NotLeader")
		expect(select(2, book:invite(3, 2, 0, SECONDS))).toBe("TheyAreInParty")
	end)

	it("stops at the party size and drops open invites of a full party", function()
		local book = Parties.new(3)
		book:invite(1, 2, 0, SECONDS)
		book:invite(1, 3, 0, SECONDS)
		book:invite(1, 4, 0, SECONDS)
		book:answer(2, 1, true)
		book:answer(3, 1, true)
		expect(#book:membersOf(1)).toBe(3)
		expect(book:inviteTo(4)).toBe(nil)
		expect(select(2, book:invite(1, 5, 0, SECONDS))).toBe("Full")
	end)

	it("lets invites expire", function()
		local book = Parties.new(4)
		book:invite(1, 2, 0, SECONDS)
		book:expire(SECONDS - 1)
		expect(book:inviteTo(2) ~= nil).toBe(true)
		book:expire(SECONDS)
		expect(book:inviteTo(2)).toBe(nil)
	end)

	it("voids other invites once a player joined a party", function()
		local book = Parties.new(4)
		book:invite(1, 3, 0, SECONDS)
		book:invite(2, 3, 0, SECONDS)
		book:answer(3, 2, true)
		expect(book:inviteTo(3)).toBe(nil)
		expect(book:leaderOf(3)).toBe(2)
	end)
end)

describe("leaving", function()
	local function partyOfThree()
		local book = Parties.new(4)
		book:invite(1, 2, 0, SECONDS)
		book:answer(2, 1, true)
		book:invite(1, 3, 0, SECONDS)
		book:answer(3, 1, true)
		return book
	end

	it("hands the lead to the next member when the leader leaves", function()
		local book = partyOfThree()
		book:invite(1, 4, 0, SECONDS)
		book:leave(1)
		expect(book:get(1)).toBe(nil)
		expect(book:leaderOf(3)).toBe(2)
		expect(book:inviteTo(4)).toBe(nil) -- the old leader's invite is void
	end)

	it("ends a party that is down to one player", function()
		local book = partyOfThree()
		book:leave(3)
		book:remove(2) -- left the server
		expect(book:get(1)).toBe(nil)
		expect(book:leaderOf(1)).toBe(1)
		expect(#book:membersOf(1)).toBe(1)
	end)

	it("only lets the leader kick members", function()
		local book = partyOfThree()
		expect(select(2, book:kick(2, 3))).toBe("NotLeader")
		expect(select(2, book:kick(1, 9))).toBe("NotInParty")
		expect((book:kick(1, 3))).toBe(true)
		expect(book:get(3)).toBe(nil)
		expect(#book:membersOf(1)).toBe(2)
	end)
end)

describe("coming back from the run place", function()
	it("forms the party again with the old leader in front", function()
		local book = Parties.new(4)
		book:arrive(7, "tag", 8, 0, 120)
		expect(book:get(7)).toBe(nil) -- alone so far
		book:arrive(8, "tag", 8, 1, 120)
		expect(book:leaderOf(7)).toBe(8)
		book:arrive(9, "tag", 8, 2, 120)
		expect(#book:membersOf(9)).toBe(3)
		expect(book:get(9).tag).toBe("tag")
	end)

	it("forgets the tag after a while and keeps other parties apart", function()
		local book = Parties.new(4)
		book:arrive(7, "a", 7, 0, 120)
		book:arrive(8, "b", 8, 0, 120)
		expect(book:get(7)).toBe(nil)
		book:expire(121)
		book:arrive(9, "a", 7, 121, 120)
		expect(book:get(9)).toBe(nil) -- 7's wait for "a" is over
	end)

	it("does not pull in someone who joined another party meanwhile", function()
		local book = Parties.new(4)
		book:arrive(7, "tag", 7, 0, 120)
		book:invite(5, 7, 0, SECONDS)
		book:answer(7, 5, true)
		book:arrive(8, "tag", 7, 1, 120)
		expect(book:get(8)).toBe(nil)
		expect(book:leaderOf(7)).toBe(5)
	end)
end)
