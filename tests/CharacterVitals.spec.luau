--!strict
-- Character damage/healing policies exercised by CombatService through the real Vitals implementation.
local Vitals = require(game:GetService("ServerScriptService").Server.Services.CombatService.Vitals)
local settings = { minDamagePerHit = 1, hitInvulnerabilityMin = 0.4, hitInvulnerabilityMax = 0.4 }

describe("Character vital policies", function()
	it("prevents all ordinary healing without changing maximum HP", function()
		local v = Vitals.new(30, settings)
		v:setCharacterRules(true, false)
		v:hit(10, 0)
		expect(v:heal(5)).toBe(0)
		expect(v:heal(100)).toBe(0)
		expect(v.hp).toBe(20)
		expect(v.maxHp).toBe(30)
		v:setFraction(1) -- between-wave reset/revive is a separate operation
		expect(v.hp).toBe(30)
	end)

	it("kills on an unblocked hit after dodge and shields, regardless of armor or max HP", function()
		local v = Vitals.new(50, settings)
		v:setCharacterRules(false, true)
		v:setDefense(0.01, 0.5)
		v:setHitShields(1)
		local taken, dodged, blocked = v:hit(1, 0, 0.1)
		expect(taken).toBe(0)
		expect(dodged).toBe(true)
		expect(v.hitShields).toBe(1)
		taken, dodged, blocked = v:hit(1, 1, 0.9) -- dodges and blocks start the minimum protection (Brotato)
		expect(blocked).toBe(true)
		expect(v.hp).toBe(50)
		expect(v:hit(1, 2, 0.9)).toBe(50)
		expect(v:isDown()).toBe(true)
	end)

	it("applies one-hit death to lethal self-damage after a hit shield", function()
		local v = Vitals.new(50, settings)
		v:setCharacterRules(false, true)
		v:setHitShields(1)
		v:protect(0, 10)
		local lost, blocked = v:drain(1)
		expect(lost).toBe(0)
		expect(blocked).toBe(true)
		expect(v:drain(1)).toBe(50)
	end)

	it("changes character policies without leaking them to another player or run", function()
		local a = Vitals.new(20, settings)
		local b = Vitals.new(20, settings)
		a:setCharacterRules(true, true)
		b:hit(2, 0)
		expect(b:heal(1)).toBe(1)
		a:setCharacterRules(false, false)
		a:reset(20)
		expect(a:hit(2, 0)).toBe(2)
		expect(a:heal(1)).toBe(1)
	end)
end)
