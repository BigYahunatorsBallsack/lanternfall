--!strict
-- Native Well-Rounded has all26 starts, no extra equipment and its original free stat package.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("WellRounded")
describe("Native Well-Rounded", function()
	it("runs all26 native starting choices without granting other equipment", function()
		f.starts(26)
	end)
	it("applies original units and stats only to its owner and requires no unlock", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(15)
		expect(f.Stats.getStat(f.me, "speed")).toBe(5)
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(8)
		expect(f.Stats.getStat(f.peer, "maxHp")).toBe(10)
		expect(f.Stats.getStat(f.peer, "speed")).toBe(0)
		expect(require(f.Shared.Util.CharacterAccess).characterUnlocked(nil, "WellRounded")).toBe(true)
		expect(f.class.displayName).toBe("Well-Rounded")
		expect(#f.world.errors).toBe(0)
	end)
end)
