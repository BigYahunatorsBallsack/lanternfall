--!strict
-- Glutton's17 native starts, original stat package and Hungry's per-run consumption challenge; explosion details remain in CharacterGlutton.spec.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Glutton")
describe("Native Glutton package", function()
	it("runs all17 native starts without extra starting items", function()
		f.starts(17)
	end)
	it("applies the original Luck/price/XP rules only to the owner", function()
		f.start("BrassKnuckles")
		expect(f.Stats.getStat(f.me, "luck")).toBe(50)
		expect(f.Stats.getStat(f.me, "itemPrice")).toBe(25)
		expect(f.Stats.getStat(f.me, "xpGain")).toBe(-25)
		local XP = require(f.S.ExperienceService)
		assert(XP.addXp(8, f.me))
		expect(XP.getProgress(f.me).xp).toBe(6)
		expect(XP.getProgress(f.peer).xp).toBe(0)
	end)
	it("counts physical consumables across waves of one run and isolates the collector", function()
		f.start("BrassKnuckles")
		local Loot = require(f.S.LootService)
		local Access = require(f.Shared.Util.CharacterAccess)
		local function consume(kind)
			Loot.dropPickup(f.peer.Character.HumanoidRootPart.Position, kind)
			f.world.advance(0.1)
		end
		for _ = 1, 9 do
			consume("Fruit")
		end
		f.nextWave()
		for _ = 1, 10 do
			consume("Fruit")
		end
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Glutton")).toBe(false)
		consume("Crate")
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Glutton")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
	it("resets unfinished consumption on a new run and restores the wave-start count on retry", function()
		local Access = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).achievements[Access.challengeKey("chal_hungry")] = nil
		local Loot = require(f.S.LootService)
		local function consume(count)
			for _ = 1, count do
				Loot.dropPickup(f.peer.Character.HumanoidRootPart.Position, "Fruit")
				f.world.advance(0.1)
			end
		end
		f.start("BrassKnuckles")
		consume(10)
		f.start("BrassKnuckles")
		consume(10)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Glutton")).toBe(false)
		f.nextWave()
		consume(9)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		consume(1)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Glutton")).toBe(false)
		consume(9)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Glutton")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
