--!strict
-- Source fog visibility, shared additive masks and transient light lifetimes are tested independently of Roblox image allocation.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Rules = require(Shared.Util.NativeFogRules)
local Raster = require(Shared.Util.NativeFogRaster)
local C = require(Shared.Config.NativeFog)
describe("Native fog", function()
	it("uses original capped wave scale and visibility bounds", function()
		expect(Rules.waveScale(1)).toBeNear(2.6625)
		expect(Rules.waveScale(20)).toBe(1)
		expect(Rules.waveScale(100)).toBe(1)
		expect(Rules.visibility(-101)).toBe(0)
		expect(Rules.visibility(25)).toBe(1.25)
		expect(Rules.visibility(10000)).toBe(100.99)
		expect(Rules.permanentLoss(1)).toBe(16.5)
		expect(Rules.permanentLoss(30)).toBe(45)
	end)
	it("keeps the original nested light layers and animation key durations", function()
		expect(#C.lights.player.layers).toBe(3)
		expect(C.lights.player.layers[3].rotation.length).toBe(365)
		expect(C.lights.player.layers[3].rotation.keyEnd).toBe(366)
		expect(Rules.pulse(C.lights.player.pulse, 0)).toBe(1.5)
		expect(Rules.pulse(C.lights.player.pulse, 0.7)).toBe(1.55)
		expect(Rules.pulse(C.lights.structure.pulse, 1.4)).toBe(0.5)
	end)
	it("shares and saturates light from different players without revealing the unlit corners", function()
		local lights = { { x = 50, y = 54, kind = "player", age = 0, visibility = 0, fade = 1 } }
		local pixels = Raster.draw(192, 108, 20, lights)
		local function alpha(x, y)
			return buffer.readu8(pixels, (y * 192 + x) * 4 + 3)
		end
		expect(alpha(50, 54)).toBe(0)
		expect(alpha(140, 54)).toBe(255)
		expect(alpha(0, 0)).toBe(255)
		table.insert(lights, { x = 140, y = 54, kind = "player", age = 0, visibility = 0, fade = 1 })
		pixels = Raster.draw(192, 108, 20, lights)
		expect(alpha(50, 54)).toBe(0)
		expect(alpha(140, 54)).toBe(0)
		expect(alpha(0, 0)).toBe(255)
	end)
	it("suppresses minus100 visibility and extends the radius on early waves", function()
		local light = { x = 96, y = 54, kind = "player", age = 0, visibility = -100, fade = 1 }
		local blank = Raster.draw(192, 108, 1, { light })
		expect(buffer.readu8(blank, (54 * 192 + 96) * 4 + 3)).toBe(255)
		light.visibility = 0
		local early = Raster.draw(192, 108, 1, { light })
		local late = Raster.draw(192, 108, 20, { light })
		local index = (54 * 192 + 150) * 4 + 3
		expect(buffer.readu8(early, index) < buffer.readu8(late, index)).toBe(true)
	end)
	it("holds explosion light for a quarter second and fades it for another quarter", function()
		expect(Rules.transientFade(0.2, 0.25)).toBe(1)
		expect(Rules.transientFade(0.375, 0.25)).toBe(0.5)
		expect(Rules.transientFade(0.5, 0.25)).toBe(0)
		expect(Rules.transientFade(0.125, 0)).toBe(0.5)
	end)
end)
