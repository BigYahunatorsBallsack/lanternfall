--!strict
-- Movement intents are validated, scoped to the sender and cannot hide observed physical movement.
local world = loadHelper("tests/helpers/RobloxMock.luau")
local Server = game:GetService("ServerScriptService").Server
local Shared = game:GetService("ReplicatedStorage").Shared
runScript(Server, "init.server.luau")
local Movement = require(Server.Services.CharacterService.Movement)
Movement.init()
local Run = require(Server.Services.RunDirector)
local me = world.addPlayer("Owner", 1, true)
local peer = world.addPlayer("Peer", 2, false)
world.advance(0.5)

describe("Native character movement intents", function()
	it("ignores lobby and malformed movement intents", function()
		world.fireServerAs(me, "SetMovementIntent", true)
		expect(Movement.isMoving(me)).toBe(false)
		assert(Run.setReady(me, true))
		assert(Run.setReady(peer, true))
		world.advance(3.5)
		Run.setHoldWaves(true)
		require(Server.Services.SpawnDirector).setPaused(true)
		require(Server.Services.WeaponService).setPaused(true)
		world.fireServerAs(me, "SetMovementIntent", "moving")
		expect(Movement.isMoving(me)).toBe(false)
	end)
	it("recognizes input against a wall and isolates teammates", function()
		world.fireServerAs(me, "SetMovementIntent", true)
		expect(Movement.isMoving(me)).toBe(true)
		expect(Movement.isMoving(peer)).toBe(false)
	end)
	it("does not accept a still report as proof that a moving player is stationary", function()
		me.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(2, 0, 0)
		world.fireServerAs(me, "SetMovementIntent", false)
		expect(Movement.isMoving(me)).toBe(true)
		me.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
		expect(Movement.isMoving(me)).toBe(false)
	end)
	it("expires stale intents and discards them on run phase changes", function()
		world.fireServerAs(me, "SetMovementIntent", true)
		world.advance(require(Shared.Config.CharacterMechanics).movementIntent.lifetimeSeconds + 0.1)
		expect(Movement.isMoving(me)).toBe(false)
		world.fireServerAs(me, "SetMovementIntent", true)
		Run.endRun("Defeat")
		expect(Movement.isMoving(me)).toBe(false)
	end)
end)
