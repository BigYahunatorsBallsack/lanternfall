--!strict
-- Source delete_projectile_on_death removes only explicitly linked projectiles and returns existing end-feed pairs.
loadHelper("tests/helpers/RobloxMock.luau")
local V = require(game:GetService("ServerScriptService").Server.Services.EnemySim.Volleys)
local function make()
	return V.new({ playerRadius = 1, minX = -100, maxX = 100, minZ = -100, maxZ = 100, obstacles = {} })
end
describe("Native source-linked bullets", function()
	it("removes the dying source's linked bullets while preserving unlinked landing shots and another owner", function()
		local v = make()
		local linked = v:fire(0, 0, 1, 0, 1, 1000, 1, 5, nil, 7)
		v:fire(0, 0, 1, 0, 1, 1000, 1, 5)
		v:fire(0, 0, 1, 0, 1, 1000, 1, 5, nil, 8)
		v:step(0.1, {}, {}, 0)
		local ended = v:removeSource(7)
		expect(#ended).toBe(2)
		expect(ended[1]).toBe(linked)
		expect(ended[2]).toBeNear(0.1)
		expect(v:getCount()).toBe(2)
		expect(#v:removeSource(8)).toBe(2)
		expect(v:getCount()).toBe(1)
	end)
	it("does not invent an end event for an unknown or already removed source", function()
		local v = make()
		v:fire(0, 0, 1, 0, 1, 1000, 1, 5)
		expect(#v:removeSource(7)).toBe(0)
		expect(v:getCount()).toBe(1)
	end)
end)
