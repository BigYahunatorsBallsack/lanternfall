--!strict
-- Real pet actor integration checks native Blazemander target selection, delayed contact and cleanup.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("NightWatch")
local Actors = require(f.S.StructureService.PetActors)
local Enemy = require(f.S.EnemySim)
f.start("WatchmanPistol")
local y = f.Config.Map.arena.center.Y
local nextId = 10000
local function actor()
	nextId += 1
	local o = { id = nextId, kind = "Blazemander", owner = f.me, position = Vector3.new(0, y, 0) }
	Actors.add(o)
	return o
end
local function reset()
	Actors.clear()
	Enemy.killAll()
end
local function step(frames)
	Actors.step(frames / 60, function()
		return {}
	end, function()
		error("Unexpected mine")
	end)
end
describe("Native Blazemander", function()
	it("has no global fallback and prefers unburned targets over closer burning ones", function()
		reset()
		local o = actor()
		local far = assert(Enemy.spawn("Brute", 80, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(o.target).toBe(nil)
		Enemy.teleport(far, Vector3.new(20, y, 0))
		Enemy.setBurning(far, true)
		local fresh = assert(Enemy.spawn("Brute", -30, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(o.target).toBe(fresh)
	end)
	it("retargets burning enemies, reserves ordinary targets and shares only elites", function()
		reset()
		local first, second = actor(), actor()
		local a = assert(Enemy.spawn("Brute", 20, 0, 100, 0, nil, nil, 0))
		local b = assert(Enemy.spawn("Brute", -30, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(first.target).toBe(a)
		expect(second.target).toBe(b)
		Enemy.setBurning(a, true)
		local c = assert(Enemy.spawn("Brute", 40, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(first.target).toBe(c)
		Enemy.killAll()
		local elite = assert(Enemy.spawn(next(f.Config.Enemies.champions), 30, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(first.target).toBe(elite)
		expect(second.target).toBe(elite)
		Enemy.killAll()
		local boss = assert(Enemy.spawn(next(f.Config.Enemies.bosses), 30, 0, 100, 0, nil, nil, 0))
		step(1)
		expect(first.target).toBe(boss)
		expect(second.target).toBe(nil)
	end)
	it("delays melee, burns on contact and hits each enemy once until the hitbox closes", function()
		reset()
		local o = actor()
		local id = assert(Enemy.spawn("Brute", 0, -2, 100, 0, nil, nil, 0))
		local hp = Enemy.getHealth(id)
		step(31)
		expect(Enemy.getHealth(id)).toBe(hp)
		step(1)
		expect(Enemy.getHealth(id)).toBe(hp - 1)
		expect(Enemy.isBurning(id)).toBe(true)
		step(10)
		expect(Enemy.getHealth(id)).toBe(hp - 1)
		expect(o.blazeHitIds[id]).toBe(true)
		Actors.clear()
		step(100)
		expect(Enemy.getHealth(id)).toBe(hp - 1)
		expect(#f.world.errors).toBe(0)
	end)
end)
