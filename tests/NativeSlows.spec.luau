--!strict
-- Stable add_decaying_speed hold, diminishing additions, clamp and constant recovery in original Brotato points.
local Slow = require(game:GetService("ServerScriptService").Server.Services.EnemySim.DecayingSpeed)
describe("Native decaying enemy speed", function()
	it("holds Tranq slow then recovers at 300 points per second", function()
		local s = Slow.new()
		s:add(1, 1000, -500, 2)
		expect(s:factor(1, 1000)).toBeNear(0.5)
		s:step(2)
		expect(s:factor(1, 1000)).toBeNear(0.5)
		s:step(0.5)
		expect(s:factor(1, 1000)).toBeNear(0.65)
		s:step(2)
		expect(s:factor(1, 1000)).toBe(1)
	end)
	it("reduces another slow by twenty after the forty-five-percent boundary and refreshes the hold", function()
		local s = Slow.new()
		s:add(1, 1000, -500, 2)
		s:step(1.9)
		s:add(1, 1000, -500, 2)
		expect(s:factor(1, 1000)).toBeNear(0.475)
		s:step(1)
		expect(s:factor(1, 1000)).toBeNear(0.475)
	end)
	it("clamps Harpoon's fixed -400 to ninety percent and stops adding beyond seventy percent", function()
		local s = Slow.new()
		s:add(1, 300, -400, 0)
		expect(s:factor(1, 300)).toBeNear(0.1)
		s:add(1, 300, -400, 0)
		expect(s:factor(1, 300)).toBeNear(0.1)
		s:step(0.3)
		expect(s:factor(1, 300)).toBeNear(0.4)
		s:remove(1)
		expect(s:factor(1, 300)).toBe(1)
		s:add(2, 300, -400, 0)
		s:clear()
		expect(s:factor(2, 300)).toBe(1)
	end)
end)
