--!strict
-- Bound Dimetrodon jump source has different cold/reset timers, captured targets and screen-plane height without an invented landing AoE.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local C = require(Shared.Config.NativeDimetrodon)
local Jump = require(game:GetService("ServerScriptService").Server.Services.EnemySim.NativeJump)
local rule = C.jumpRule
describe("Native jump component", function()
	it(
		"starts cold without an invented first cooldown and disables body/contact while retaining a captured target",
		function()
			local s = Jump.new(rule)
			local started, landed = Jump.step(rule, s, 0, 0, 0, 30, 40)
			expect(started).toBe(true)
			expect(landed).toBe(false)
			expect(s.jumping).toBe(true)
			expect(s.locked).toBe(true)
			expect(s.targetX).toBe(30)
			expect(s.targetZ).toBe(40)
			Jump.step(rule, s, 0.25, 0, 0, 99, 99)
			expect(s.x).toBe(0)
			expect(s.z).toBe(0)
			expect(s.height).toBe(0)
			expect(s.targetX).toBe(30)
		end
	)
	it("moves the source height along the screen plane and exposes its separate ground position", function()
		local s = Jump.new(rule)
		Jump.step(rule, s, 0, 0, 0, 30, 40)
		Jump.step(rule, s, 0.875, 0, 0, 99, 99) -- delay0.5 + progress0.25*duration1.5
		expect(s.x).toBeNear(7.5)
		expect(s.groundZ).toBeNear(10)
		expect(s.height).toBeNear(25 * math.sin(math.pi / 4))
		expect(s.z).toBeNear(10 - 25 * math.sin(math.pi / 4))
	end)
	it("uses the actual Godot ease(-3) descent rather than a symmetric sine trajectory", function()
		local s = Jump.new(rule)
		Jump.step(rule, s, 0, 0, 0, 30, 40)
		Jump.step(rule, s, 0.5 + 1.5 * 0.625, 0, 0, 30, 40)
		expect(s.height).toBeNear(25 * math.sin(0.53125 * math.pi))
		expect(s.groundZ).toBeNear(25)
	end)
	it("lands once at the captured point and cold landing unlocks on its next source step", function()
		local s = Jump.new(rule)
		Jump.step(rule, s, 0, 0, 0, 30, 40)
		local _, landed = Jump.step(rule, s, 2, 0, 0, 99, 99)
		expect(landed).toBe(true)
		expect(s.jumping).toBe(false)
		expect(s.x).toBe(30)
		expect(s.z).toBe(40)
		expect(s.height).toBe(0)
		expect(s.locked).toBe(true)
		Jump.step(rule, s, 0.1, 30, 40, 99, 99)
		expect(s.locked).toBe(false)
		expect(s.timer).toBeNear(1.9)
	end)
	it("uses the reset cooldown and full landing pause for a pooled actor", function()
		local s = Jump.new(rule)
		Jump.reset(rule, s)
		local started = Jump.step(rule, s, 1, 0, 0, 30, 40)
		expect(started).toBe(false)
		local starts = Jump.step(rule, s, 1, 0, 0, 30, 40)
		expect(starts).toBe(true)
		Jump.step(rule, s, 2, 0, 0, 30, 40)
		Jump.step(rule, s, 0.5, 30, 40, 30, 40)
		expect(s.locked).toBe(true)
		Jump.step(rule, s, 0.5, 30, 40, 30, 40)
		expect(s.locked).toBe(false)
	end)
	it("keeps waiting without a target and begins from the actual actor position when one returns", function()
		local s = Jump.new(rule)
		expect(Jump.step(rule, s, 5, 5, 7, nil, nil)).toBe(false)
		expect(s.locked).toBe(false)
		expect(Jump.step(rule, s, 0.1, 8, 9, 30, 40)).toBe(true)
		expect(s.startX).toBe(8)
		expect(s.startZ).toBe(9)
	end)
	it("does not spend excess landing-frame delta on a second state transition", function()
		local s = Jump.new(rule)
		Jump.step(rule, s, 0, 0, 0, 30, 40)
		local starts, lands = Jump.step(rule, s, 10, 0, 0, 30, 40)
		expect(starts).toBe(false)
		expect(lands).toBe(true)
		expect(s.timer).toBe(2)
		expect(s.locked).toBe(true)
	end)
	it("keeps unused landing exports inactive after normal actor registration", function()
		expect(C.actorRegistered).toBe(true)
		expect(C.worldAdapterImplemented).toBe(true)
		expect(C.nativeFullParityAccepted).toBe(false)
		expect(C.bindingAudit.directLandingDamageImplementedByBoundMethod).toBe(false)
		expect(C.jump.damage).toBe(50)
		expect(C.jump.landing_radius).toBe(180)
		expect(C.attacks.Land_shoot_behavior.properties.number_projectiles).toBe(8)
	end)
end)
