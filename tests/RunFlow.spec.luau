-- Unit tests for the run flow rules (src/server/Services/RunDirector/RunFlow.luau).
-- Run: see README "Für Entwickler".

local ServerScriptService = game:GetService("ServerScriptService")
local RunFlow = require(ServerScriptService.Server.Services.RunDirector.RunFlow)

local SETTINGS = {
	countdownSeconds = 10,
	allReadyCountdownSeconds = 3,
	resultsSeconds = 15,
	waveEnds = { 20, 45, 75 },
	shopSeconds = 30,
	maxPlayers = 4,
	defaultClassId = "BladeWarden",
	endlessWaveSeconds = 60,
}

local function kinds(events)
	local list = {}
	for _, event in events do
		table.insert(list, if event.phase then `{event.kind}:{event.phase}` else event.kind)
	end
	return table.concat(list, ",")
end

local function newFlow(playerCount)
	local clock = fakeTime()
	local flow = RunFlow.new(SETTINGS)
	for i = 1, playerCount do
		flow:addPlayer(i, `Player{i}`)
	end
	return flow, clock
end

-- Solo player readies up and the run starts after the short countdown.
local function startSolo()
	local flow, clock = newFlow(1)
	flow:setReady(1, true, clock.now)
	clock.advance(SETTINGS.allReadyCountdownSeconds)
	flow:update(clock.now)
	flow:drainEvents()
	return flow, clock
end

describe("RunFlow", function()
	describe("lobby and countdown", function()
		it("starts in the lobby with the default class", function()
			local flow = newFlow(1)
			expect(flow.phase).toBe("Lobby")
			local snapshot = flow:snapshot()
			expect(#snapshot.players).toBe(1)
			expect(snapshot.players[1].classId).toBe("BladeWarden")
			expect(snapshot.players[1].ready).toBe(false)
		end)

		it("uses the short countdown when everyone is ready", function()
			local flow, clock = newFlow(1)
			flow:setReady(1, true, clock.now)
			expect(flow.phase).toBe("Countdown")
			expect(flow.phaseEndsAt).toBeNear(clock.now + 3)
		end)

		it("uses the long countdown while someone is not ready, then cuts it", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			expect(flow.phaseEndsAt).toBeNear(clock.now + 10)
			clock.advance(5)
			flow:setReady(2, true, clock.now)
			expect(flow.phaseEndsAt).toBeNear(clock.now + 3)
		end)

		it("never extends the countdown when everyone gets ready late", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			local endsAt = flow.phaseEndsAt
			clock.advance(8.5)
			flow:setReady(2, true, clock.now)
			expect(flow.phaseEndsAt).toBeNear(endsAt)
		end)

		it("goes back to the lobby when the last ready player cancels", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(1, false, clock.now)
			expect(flow.phase).toBe("Lobby")
			expect(flow.phaseEndsAt).toBe(nil)
		end)

		it("goes back to the lobby when the only ready player leaves", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:removePlayer(1, clock.now)
			expect(flow.phase).toBe("Lobby")
		end)

		it("starts the run with only the ready players", function()
			local flow, clock = newFlow(3)
			flow:setReady(2, true, clock.now)
			flow:setReady(3, true, clock.now)
			flow:drainEvents()
			clock.advance(10)
			flow:update(clock.now)
			expect(kinds(flow:drainEvents())).toBe("RunStarted,PhaseChanged:Running")
			expect(flow.phase).toBe("Running")
			expect(flow:isParticipant(1)).toBe(false)
			expect(flow:isParticipant(2)).toBe(true)
			expect(flow:isParticipant(3)).toBe(true)
			expect(flow.runStartedAt).toBeNear(clock.now)
			-- ready flags are consumed by the run
			expect(flow.players[2].ready).toBe(false)
		end)

		it("takes at most maxPlayers, in the order they got ready", function()
			local flow, clock = newFlow(6)
			for _, userId in { 6, 5, 4, 3, 2, 1 } do
				flow:setReady(userId, true, clock.now)
			end
			clock.advance(3)
			flow:update(clock.now)
			local ids = flow:getParticipantIds()
			expect(table.concat(ids, ",")).toBe("3,4,5,6")
			-- the others stay ready for the next run
			expect(flow.players[1].ready).toBe(true)
		end)

		it("locks the class for the run", function()
			local flow = startSolo()
			local ok, reason = flow:setClass(1, "SparkMage")
			expect(ok).toBe(false)
			expect(reason).toBe("InRun")
		end)

		it("lets lobby players change class and queue up during a run", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			expect(flow:setClass(2, "SparkMage")).toBe(true)
			expect(flow:setReady(2, true, clock.now)).toBe(true)
			expect(flow.phase).toBe("Running")
		end)
	end)

	describe("run", function()
		it("opens the shop when a wave ends and stops the clock exactly there", function()
			local flow, clock = startSolo()
			expect(flow.wave).toBe(1)
			clock.advance(19.9)
			flow:update(clock.now)
			expect(flow.phase).toBe("Running")
			clock.advance(0.3) -- a frame late: the clock still stops at the wave's end
			flow:update(clock.now)
			expect(flow.phase).toBe("Shop")
			expect(flow.wave).toBe(1)
			expect(flow:getElapsed(clock.now)).toBeNear(20)
			expect(flow.phaseEndsAt).toBeNear(clock.now + SETTINGS.shopSeconds)
			clock.advance(10)
			expect(flow:getElapsed(clock.now)).toBeNear(20)
		end)

		it("starts the next wave when the shop timer runs out", function()
			local flow, clock = startSolo()
			clock.advance(20)
			flow:update(clock.now)
			clock.advance(SETTINGS.shopSeconds)
			flow:update(clock.now)
			expect(flow.phase).toBe("Running")
			expect(flow.wave).toBe(2)
			expect(flow:getElapsed(clock.now)).toBeNear(20)
			clock.advance(5)
			expect(flow:getElapsed(clock.now)).toBeNear(25)
		end)

		it("starts the next wave once every participant still in the game is ready", function()
			local flow, clock = newFlow(3)
			for userId = 1, 3 do
				flow:setReady(userId, true, clock.now)
			end
			clock.advance(3)
			flow:update(clock.now)
			flow:setParticipantState(3, "Out", clock.now)
			clock.advance(20)
			flow:update(clock.now)
			expect(flow.phase).toBe("Shop")
			expect(flow:setShopReady(1, true, clock.now)).toBe(true)
			expect(flow.phase).toBe("Shop")
			expect(flow:snapshot().players[1].shopReady).toBe(true)
			flow:setShopReady(2, true, clock.now)
			expect(flow.phase).toBe("Running")
			expect(flow.wave).toBe(2)
		end)

		it("rejects Ready outside the shop and from non-participants", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			local ok, reason = flow:setShopReady(1, true, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotShopping")
			clock.advance(20)
			flow:update(clock.now)
			ok, reason = flow:setShopReady(2, true, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotParticipant")
		end)

		it("keeps lobby players out of the run while the shop is open", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			clock.advance(20)
			flow:update(clock.now)
			expect(flow:isInRun(1)).toBe(true)
			expect(flow:isActive()).toBe(false)
			local ok, reason = flow:setReady(1, false, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("InRun")
		end)

		it("wins when the final (boss) wave runs out", function()
			local flow, clock = startSolo()
			for wave = 1, 2 do
				clock.advance(SETTINGS.waveEnds[wave] - flow:getElapsed(clock.now))
				flow:update(clock.now)
				expect(flow.phase).toBe("Shop")
				flow:setShopReady(1, true, clock.now)
				expect(flow.wave).toBe(wave + 1)
			end
			clock.advance(29.9)
			flow:update(clock.now)
			expect(flow.phase).toBe("Running")
			clock.advance(0.1)
			flow:update(clock.now)
			expect(flow.phase).toBe("Ended")
			expect(flow.results.outcome).toBe("Victory")
		end)

		it("ends in defeat when every participant is down", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			flow:drainEvents()
			clock.advance(100)
			flow:setParticipantState(1, "Down", clock.now)
			expect(flow.phase).toBe("Running")
			flow:setParticipantState(2, "Down", clock.now)
			expect(flow.phase).toBe("Ended")
			expect(flow.results.outcome).toBe("Defeat")
			expect(flow.results.survivedSeconds).toBeNear(100)
			expect(#flow.results.players).toBe(2)
		end)

		it("keeps running when a downed player is revived in time", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			flow:setParticipantState(1, "Down", clock.now)
			flow:setParticipantState(1, "Alive", clock.now)
			flow:setParticipantState(2, "Down", clock.now)
			expect(flow.phase).toBe("Running")
		end)

		it("counts Out (spectating) as not alive", function()
			local flow, clock = startSolo()
			flow:setParticipantState(1, "Out", clock.now)
			expect(flow.phase).toBe("Ended")
		end)

		it("ends in victory via endRun (the bosses died) and freezes the timer", function()
			local flow, clock = startSolo()
			flow:skipTo(50, clock.now) -- into the last wave
			expect(flow.phase).toBe("Running")
			expect(flow.wave).toBe(3)
			clock.advance(10)
			expect(flow:endRun("Victory", clock.now)).toBe(true)
			expect(flow.results.outcome).toBe("Victory")
			expect(flow.results.survivedSeconds).toBeNear(60)
			clock.advance(5)
			expect(flow:getElapsed(clock.now)).toBeNear(60)
		end)

		it("ends as abandoned during the shop when everyone leaves", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			clock.advance(20)
			flow:update(clock.now)
			flow:removePlayer(1, clock.now)
			flow:removePlayer(2, clock.now)
			expect(flow.phase).toBe("Lobby")
		end)

		it("rejects endRun and state changes outside a run", function()
			local flow, clock = newFlow(1)
			expect(flow:endRun("Victory", clock.now)).toBe(false)
			local ok, reason = flow:setParticipantState(1, "Down", clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotRunning")
		end)

		it("rejects state changes for players outside the run", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			local ok, reason = flow:setParticipantState(2, "Down", clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotParticipant")
		end)

		it("ends as abandoned and returns to the lobby when everyone leaves", function()
			local flow, clock = startSolo()
			flow:removePlayer(1, clock.now)
			expect(kinds(flow:drainEvents())).toBe("RunEnded,PhaseChanged:Lobby")
			expect(flow.phase).toBe("Lobby")
		end)

		it("continues when one of two participants leaves", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			flow:removePlayer(1, clock.now)
			expect(flow.phase).toBe("Running")
			flow:setParticipantState(2, "Down", clock.now)
			expect(flow.phase).toBe("Ended")
			expect(#flow.results.players).toBe(1)
		end)

		it("ends in defeat when the last alive player leaves and the rest are down", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			flow:setParticipantState(1, "Down", clock.now)
			flow:removePlayer(2, clock.now)
			expect(flow.phase).toBe("Ended")
			expect(flow.results.outcome).toBe("Defeat")
		end)
	end)

	describe("skipTo", function()
		it("moves the timer forward into the wave that contains it", function()
			local flow, clock = startSolo()
			expect(flow:skipTo(30, clock.now)).toBe(true)
			expect(flow:getElapsed(clock.now)).toBeNear(30)
			expect(flow.wave).toBe(2)
			expect(flow.phase).toBe("Running")
		end)

		it("opens the shop when skipping to a wave's end", function()
			local flow, clock = startSolo()
			flow:skipTo(20, clock.now)
			expect(flow.phase).toBe("Shop")
			expect(flow.wave).toBe(1)
			expect(flow:getElapsed(clock.now)).toBeNear(20)
		end)

		it("never goes backwards", function()
			local flow, clock = startSolo()
			clock.advance(10)
			local ok, reason = flow:skipTo(5, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("AlreadyPast")
		end)

		it("stops at the end of the run, which wins", function()
			local flow, clock = startSolo()
			flow:skipTo(5000, clock.now)
			expect(flow:getElapsed(clock.now)).toBeNear(75)
			expect(flow.phase).toBe("Ended")
			expect(flow.results.outcome).toBe("Victory")
		end)

		it("only works while running", function()
			local flow, clock = newFlow(1)
			expect(flow:skipTo(60, clock.now)).toBe(false)
		end)
	end)

	describe("results", function()
		it("returns to the lobby after the results time", function()
			local flow, clock = startSolo()
			flow:endRun("Victory", clock.now)
			flow:drainEvents()
			clock.advance(14.9)
			flow:update(clock.now)
			expect(flow.phase).toBe("Ended")
			clock.advance(0.1)
			flow:update(clock.now)
			expect(flow.phase).toBe("Lobby")
			expect(flow.results).toBe(nil)
			expect(next(flow.participants)).toBe(nil)
		end)

		it("skips the rest of the results when everyone presses Play again", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			flow:endRun("Victory", clock.now)
			flow:setReady(1, true, clock.now)
			expect(flow.phase).toBe("Ended")
			flow:drainEvents()
			flow:setReady(2, true, clock.now)
			expect(kinds(flow:drainEvents())).toBe("PhaseChanged:Lobby,PhaseChanged:Countdown")
			expect(flow.phaseEndsAt).toBeNear(clock.now + 3)
		end)

		it("does not wait for lobby players who were not in the run", function()
			local flow, clock = newFlow(2)
			flow:setReady(1, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			flow:endRun("Defeat", clock.now)
			flow:setReady(1, true, clock.now)
			expect(flow.phase).toBe("Countdown")
		end)

		it("starts the next run after Play again", function()
			local flow, clock = startSolo()
			flow:endRun("Victory", clock.now)
			flow:setReady(1, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			expect(flow.phase).toBe("Running")
			expect(flow:getElapsed(clock.now)).toBeNear(0)
		end)

		it("keeps the played class in the results when the next class is picked", function()
			local flow, clock = startSolo()
			flow:endRun("Victory", clock.now)
			flow:setClass(1, "SparkMage")
			expect(flow.results.players[1].classId).toBe("BladeWarden")
			expect(flow:snapshot().players[1].classId).toBe("SparkMage")
		end)

		it("returns to the lobby when the last participant leaves the results", function()
			local flow, clock = startSolo()
			flow:endRun("Victory", clock.now)
			flow:removePlayer(1, clock.now)
			expect(flow.phase).toBe("Lobby")
		end)
	end)

	describe("run options and endless mode (B11)", function()
		it("locks the lobby's options at run start", function()
			local flow, clock = newFlow(1)
			flow:setOptions({ danger = 3, endless = true, enemyHp = 100, enemyDamage = 100, enemySpeed = 100 })
			flow:setReady(1, true, clock.now)
			clock.advance(SETTINGS.allReadyCountdownSeconds)
			flow:update(clock.now)
			flow:setOptions({ danger = 1, endless = false, enemyHp = 100, enemyDamage = 100, enemySpeed = 100 })
			expect(flow:getRunOptions().danger).toBe(3)
			expect(flow:snapshot().difficulty).toBe("Danger 3 · Endless")
			expect(flow:snapshot().options.danger).toBe(1)
		end)

		it("goes on after the last wave in endless mode and counts dying there as a win", function()
			local flow, clock = newFlow(1)
			flow:setOptions({ danger = 0, endless = true, enemyHp = 100, enemyDamage = 100, enemySpeed = 100 })
			flow:setReady(1, true, clock.now)
			clock.advance(SETTINGS.allReadyCountdownSeconds)
			flow:update(clock.now)
			expect(flow:skipTo(75, clock.now)).toBe(true) -- end of the last wave
			expect(flow.phase).toBe("Shop")
			flow:setShopReady(1, true, clock.now)
			expect(flow.phase).toBe("Running")
			expect(flow.wave).toBe(4)
			expect(flow:skipTo(75 + 60, clock.now)).toBe(true) -- endless wave 4 lasts 60 s
			expect(flow.phase).toBe("Shop")
			flow:setShopReady(1, true, clock.now)
			flow:drainEvents()
			flow:setParticipantState(1, "Out", clock.now)
			local results = flow.results :: any
			expect(results.outcome).toBe("Victory")
			expect(results.wave).toBe(5)
			expect(results.endless).toBe(true)
		end)

		it("is a defeat to die before the end of the last wave in endless mode", function()
			local flow, clock = newFlow(1)
			flow:setOptions({ danger = 0, endless = true, enemyHp = 100, enemyDamage = 100, enemySpeed = 100 })
			flow:setReady(1, true, clock.now)
			clock.advance(SETTINGS.allReadyCountdownSeconds)
			flow:update(clock.now)
			flow:setParticipantState(1, "Out", clock.now)
			expect((flow.results :: any).outcome).toBe("Defeat")
		end)
	end)

	describe("First Night (Paket 19)", function()
		local function firstNightFlow()
			local clock = fakeTime()
			local settings = table.clone(SETTINGS)
			settings.firstNightWaves = 2
			local flow = RunFlow.new(settings)
			flow:addPlayer(1, "Player1")
			flow:setOptions({
				danger = 0,
				endless = false,
				enemyHp = 75,
				enemyDamage = 50,
				enemySpeed = 100,
				firstNight = true,
			})
			expect(flow:launch({ 1 }, clock.now)).toBe(true)
			clock.advance(SETTINGS.countdownSeconds)
			flow:update(clock.now)
			flow:drainEvents()
			return flow, clock
		end

		it("wins after its shorter number of waves", function()
			local flow, clock = firstNightFlow()
			expect(flow.phase).toBe("Running")
			expect(flow:skipTo(20, clock.now)).toBe(true)
			expect(flow.phase).toBe("Shop")
			flow:setShopReady(1, true, clock.now)
			expect(flow.wave).toBe(2)
			expect(flow:skipTo(45, clock.now)).toBe(true) -- end of wave 2 = end of the First Night, no shop
			expect(flow.phase).toBe("Ended")
			expect((flow.results :: any).outcome).toBe("Victory")
			expect((flow.results :: any).wave).toBe(2)
		end)

		it("does not skip past its last wave", function()
			local flow, clock = firstNightFlow()
			expect(flow:skipTo(500, clock.now)).toBe(true)
			expect(flow.phase).toBe("Ended")
			expect(flow.wave).toBe(2)
		end)

		it("keeps a normal run at every wave", function()
			local settings = table.clone(SETTINGS)
			settings.firstNightWaves = 2
			local clock = fakeTime()
			local flow = RunFlow.new(settings)
			flow:addPlayer(1, "Player1")
			flow:setReady(1, true, clock.now)
			clock.advance(SETTINGS.allReadyCountdownSeconds)
			flow:update(clock.now)
			expect(flow:skipTo(45, clock.now)).toBe(true)
			expect(flow.phase).toBe("Shop")
		end)
	end)

	describe("snapshot", function()
		it("lists players in join order with run state", function()
			local flow, clock = newFlow(3)
			flow:setReady(2, true, clock.now)
			clock.advance(10)
			flow:update(clock.now)
			local snapshot = flow:snapshot()
			expect(snapshot.phase).toBe("Running")
			expect(snapshot.players[1].userId).toBe(1)
			expect(snapshot.players[1].participant).toBe(false)
			expect(snapshot.players[1].state).toBe(nil)
			expect(snapshot.players[2].participant).toBe(true)
			expect(snapshot.players[2].state).toBe("Alive")
			expect(snapshot.runStartedAt).toBeNear(clock.now)
		end)

		it("bumps the version on every change only", function()
			local flow, clock = newFlow(1)
			local version = flow.version
			flow:setReady(1, false, clock.now)
			expect(flow.version).toBe(version)
			flow:setReady(1, true, clock.now)
			expect(flow.version > version).toBe(true)
		end)
	end)
	describe("retry wave (B11 part 2)", function()
		local function retrySettings(maxRetries)
			local settings = table.clone(SETTINGS)
			settings.maxRetries = maxRetries
			return settings
		end

		-- Two players lose in wave 2 after 10 seconds of it (shop of wave 1 took 5 seconds).
		local function loseInWave2(maxRetries)
			local clock = fakeTime()
			local flow = RunFlow.new(retrySettings(maxRetries))
			flow:addPlayer(1, "Player1")
			flow:addPlayer(2, "Player2")
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			clock.advance(20)
			flow:update(clock.now)
			expect(flow.phase).toBe("Shop")
			clock.advance(5)
			flow:setShopReady(1, true, clock.now)
			flow:setShopReady(2, true, clock.now)
			expect(flow.wave).toBe(2)
			clock.advance(10)
			flow:setParticipantState(1, "Out", clock.now)
			flow:setParticipantState(2, "Down", clock.now)
			expect(flow.phase).toBe("Ended")
			flow:drainEvents()
			return flow, clock
		end

		it("offers the retries left after a defeat only", function()
			local flow = loseInWave2(2)
			expect(flow.results.retriesLeft).toBe(2)
			local never = loseInWave2(nil)
			expect(never.results.retriesLeft).toBe(0)
			expect(never:retryWave(1, 0)).toBe(false)
		end)

		it("starts the lost wave again from its beginning with everyone standing", function()
			local flow, clock = loseInWave2(2)
			flow:setReady(2, true, clock.now) -- "Play again" no longer counts after a retry
			clock.advance(4)
			local ok = flow:retryWave(1, clock.now)
			expect(ok).toBe(true)
			expect(kinds(flow:drainEvents())).toBe(
				"WaveRetried,ParticipantStateChanged,ParticipantStateChanged,PhaseChanged:Running"
			)
			expect(flow.phase).toBe("Running")
			expect(flow.wave).toBe(2)
			expect(flow:getElapsed(clock.now)).toBeNear(20)
			expect(flow:getParticipantState(1)).toBe("Alive")
			expect(flow:getParticipantState(2)).toBe("Alive")
			expect(flow.players[2].ready).toBe(false)
			expect(flow.results).toBe(nil)
			-- the wave runs its full length again, then the shop opens
			clock.advance(24.9)
			flow:update(clock.now)
			expect(flow.phase).toBe("Running")
			clock.advance(0.2)
			flow:update(clock.now)
			expect(flow.phase).toBe("Shop")
		end)

		it("counts the retries down and stops at zero", function()
			local flow, clock = loseInWave2(1)
			expect(flow:retryWave(2, clock.now)).toBe(true)
			flow:setParticipantState(1, "Down", clock.now)
			flow:setParticipantState(2, "Down", clock.now)
			expect(flow.phase).toBe("Ended")
			expect(flow.results.retriesLeft).toBe(0)
			local ok, reason = flow:retryWave(1, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NoRetriesLeft")
		end)

		it("rejects non-participants, victories and other phases", function()
			local flow, clock = loseInWave2(2)
			local ok, reason = flow:retryWave(99, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotParticipant")
			flow:retryWave(1, clock.now)
			ok, reason = flow:retryWave(1, clock.now)
			expect(ok).toBe(false)
			expect(reason).toBe("NotDefeated")
			flow:endRun("Victory", clock.now)
			ok, reason = flow:retryWave(1, clock.now)
			expect(reason).toBe("NotDefeated")
		end)

		it("starts a fresh run with all retries again", function()
			local flow, clock = loseInWave2(1)
			flow:retryWave(1, clock.now)
			expect(flow.retries).toBe(1)
			flow:endRun("Defeat", clock.now)
			clock.advance(SETTINGS.resultsSeconds + 1)
			flow:update(clock.now)
			expect(flow.phase).toBe("Lobby")
			flow:setReady(1, true, clock.now)
			flow:setReady(2, true, clock.now)
			clock.advance(3)
			flow:update(clock.now)
			expect(flow.retries).toBe(0)
		end)
	end)
end)
