--!strict
-- Actual global DLC Sea Pig keeps edge patrol and grants one original Curse to its credited player after normal death listeners.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("WellRounded")
local Enemy = require(f.S.EnemySim)
local Kinds = require(f.Shared.Util.EnemyKinds)
local function start()
	f.start("WatchmanPistol")
	f.Weapons.setPaused(true)
	require(f.S.StructureService).setPaused(true)
	require(f.S.MapService).setMovementCheck(false)
	f.me.Character.HumanoidRootPart.Position = Vector3.new(80, 100, 80)
	f.peer.Character.HumanoidRootPart.Position = Vector3.new(-80, 100, -80)
end
local function spawn()
	return assert(Enemy.spawn("SeaPig", 0, 0, 1, 1, nil, nil, 0, 10))
end
describe("Registered global DLC Sea Pig", function()
	it("keeps the actual body, growth and eligibility facts", function()
		local k = assert(Kinds.get("SeaPig"), "SeaPig is not registered")
		expect(k.typeId).toBe(70)
		expect(k.hp).toBe(30)
		expect(k.hpPerWave).toBe(15)
		expect(k.speed).toBe(15)
		expect(k.xp).toBe(5)
		expect(k.radius).toBeNear(2.8)
		expect(k.hurtRadius).toBeNear(4.6)
		expect(k.nativeHurtOffsetZ).toBeNear(-2.4)
		expect(k.nativeHitOffsetZ).toBeNear(-0.5)
		expect(k.nativeCanBeBoosted).toBe(false)
		expect(k.nativeCanBeCharmed).toBe(false)
		expect(k.nativeEdgePatrol.edgeDistancePoints).toBe(150)
		expect(k.nativePlayerKillStats.curse).toBe(1)
	end)
	it("grants one Curse to the actual killer only after normal death listeners", function()
		start()
		local id = spawn()
		expect(Enemy.getMaxHealth(id)).toBe(165)
		local before = (f.Stats.getSheet(f.me).curse or 0)
		local peerBefore = (f.Stats.getSheet(f.peer).curse or 0)
		local seen = nil
		local c = Enemy.EnemyKilled:Connect(function(info)
			if info.id == id then
				seen = (f.Stats.getSheet(f.me).curse or 0)
			end
		end)
		Enemy.damage(id, 1e9, f.me)
		c:Disconnect()
		expect(seen).toBe(before)
		expect((f.Stats.getSheet(f.me).curse or 0)).toBe(before + 1)
		expect((f.Stats.getSheet(f.peer).curse or 0)).toBe(peerBefore)
		expect(#f.world.errors).toBe(0)
	end)
	it("does not reward an uncredited death or cleanup and rejects ordinary Charm", function()
		start()
		local id = spawn()
		Enemy.damage(id, 1)
		expect(Enemy.tryCharm(f.me, id, { charmChance = 100, charmThreshold = 1 }, function()
			return 0
		end)).toBe(false)
		local before = (f.Stats.getSheet(f.me).curse or 0)
		Enemy.damage(id, 1e9, nil)
		expect((f.Stats.getSheet(f.me).curse or 0)).toBe(before)
		spawn()
		Enemy.killAll(f.me)
		expect((f.Stats.getSheet(f.me).curse or 0)).toBe(before)
	end)
end)

describe("Uncredited charmed-enemy source", function()
	it("does not turn a charmed enemy's source dummy index into a player Curse reward", function()
		start()
		local id = spawn()
		local ally = assert(Enemy.spawn("Shadeling", 0, 0, 1000, 1000, nil, nil, 0, 10))
		assert(Enemy.charmSummoned(ally, f.me.UserId))
		local before = (f.Stats.getSheet(f.me).curse or 0)
		f.world.advance(0.2, 1 / 60)
		expect(Enemy.isAlive(id)).toBe(false)
		expect((f.Stats.getSheet(f.me).curse or 0)).toBe(before)
	end)
end)
