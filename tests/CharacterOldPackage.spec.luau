--!strict
-- Native character starting alternatives, complete core rules and personal unlock boundary in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Old")
describe("Native Old package", function()
	it("runs all25 original starts", function()
		f.starts(25)
	end)
	it("uses native arena tiles and original personal stat modifiers", function()
		f.start("Revolver")
		expect(f.Stats.getStat(f.me, "enemySpeed")).toBe(-25)
		expect(f.Stats.getStat(f.me, "enemyCount")).toBe(-10)
		expect(f.Stats.getStat(f.me, "speed")).toBe(-10)
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(10)
		local bounds = require(f.S.MapService).getArenaBounds()
		expect(bounds.halfX * 2).toBeNear(134.4)
		expect(bounds.halfZ * 2).toBeNear(102.4)
		f.Run.endRun("Abandoned")
		f.world.advance(f.Config.Run.flow.resultsSeconds + 0.1)
		expect(require(f.S.MapService).getArenaBounds().halfX * 2).toBeNear(204.8)
	end)
	it("unlocks on the300th personally credited enemy kill", function()
		f.start("Revolver")
		local A = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).nativeCounts.enemiesKilled = 299
		expect(A.characterUnlocked(f.Data.get(f.peer), "Old")).toBe(false)
		local E = require(f.S.EnemySim)
		local id = assert(E.spawn("Shadeling", 40, 40, 1, 0, nil, nil, 0))
		E.damage(id, 10000, f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Old")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
