--!strict
-- Source summons use their own LIFO queue, native birth delay and player-overlap restart before optional Charm conversion.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("WellRounded")
local Enemy = require(f.S.EnemySim)
local Director = require(f.S.SpawnDirector)
local Map = require(f.S.MapService)
local Random = require(f.S.RandomService)
require(f.S.SpawnDirector.SpawnRules).groupsFor = function()
	return {}
end
local spawned = {}
local spawn = Enemy.spawn
Enemy.spawn = function(name, x, z, ...)
	local id = spawn(name, x, z, ...)
	if name == "BabyTrex" then
		table.insert(spawned, { id = id, x = x, z = z, at = workspace:GetServerTimeNow() })
	end
	return id
end
local function start()
	f.start("WatchmanPistol")
	f.Weapons.setPaused(true)
	Map.setMovementCheck(false)
	Director.setPaused(false)
	for _, player in { f.me, f.peer } do
		require(f.S.CombatService).protect(player, 10000)
	end
	table.clear(spawned)
end
describe("Native summoned births", function()
	it("waits a separate queue tick and full native birth warning before creating a body", function()
		start()
		local now = workspace:GetServerTimeNow()
		Enemy.NativeSummon:Fire("BabyTrex", 60, 0, nil)
		f.world.advance(0.95, 1 / 60)
		expect(#spawned).toBe(0)
		expect(Director.getQueued()).toBe(1)
		f.world.advance(0.5, 1 / 60)
		expect(#spawned).toBe(1)
		expect(spawned[1].at - now >= 1).toBe(true)
		expect(spawned[1].x).toBe(60)
		expect(Director.getQueued()).toBe(0)
	end)
	it("takes only one native summon per queue tick in LIFO order", function()
		start()
		Enemy.NativeSummon:Fire("BabyTrex", 40, 0, nil)
		Enemy.NativeSummon:Fire("BabyTrex", 60, 0, nil)
		f.world.advance(1.8, 1 / 60)
		expect(#spawned).toBe(2)
		expect(spawned[1].x).toBe(60)
		expect(spawned[2].x).toBe(40)
		expect(spawned[2].at > spawned[1].at).toBe(true)
	end)
	it("restarts an overlapping birth at a new random point instead of spawning on the player", function()
		start()
		local at = Map.getRootPosition(f.me)
		local oldRandom = Random.number
		Random.number = function(stream, ...)
			return if stream == "Spawns" then 0.9 else oldRandom(stream, ...)
		end
		Enemy.NativeSummon:Fire("BabyTrex", at.X, at.Z, nil)
		f.world.advance(1.4, 1 / 60)
		expect(#spawned).toBe(0)
		expect(Director.getQueued()).toBe(1)
		f.world.advance(1.3, 1 / 60)
		Random.number = oldRandom
		expect(#spawned).toBe(1)
		expect(spawned[1].x ~= at.X or spawned[1].z ~= at.Z).toBe(true)
	end)
	it("retains the captured Charm owner until birth even after the source body is removed", function()
		start()
		local source = assert(Enemy.spawn("Brute", 80, 0, 100, 0, nil, nil, 0))
		Enemy.NativeSummon:Fire("BabyTrex", 60, 0, f.me.UserId)
		Enemy.remove(source)
		f.world.advance(1.5, 1 / 60)
		expect(#spawned).toBe(1)
		expect(Enemy.isCharmed(spawned[1].id)).toBe(true)
		expect(Enemy.getCharmedCount(f.me.UserId)).toBe(1)
		expect(Enemy.getCharmedCount(f.peer.UserId)).toBe(0)
	end)
	it("clears pending births on run end and refuses summons outside a running phase", function()
		start()
		Enemy.NativeSummon:Fire("BabyTrex", 60, 0, nil)
		f.world.advance(0.3, 1 / 60)
		f.Run.endRun("Abandoned")
		Enemy.NativeSummon:Fire("BabyTrex", 40, 0, nil)
		f.world.advance(2, 1 / 60)
		expect(#spawned).toBe(0)
		expect(Director.getQueued()).toBe(0)
		expect(#f.world.errors).toBe(0)
	end)
end)
