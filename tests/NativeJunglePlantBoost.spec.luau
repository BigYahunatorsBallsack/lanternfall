--!strict
-- Actual Corrupted Buffer respects the normal mother plant's scene-bound boost immunity while its smaller child remains eligible.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("WellRounded")
local Enemy = require(f.S.EnemySim)
f.start("WatchmanPistol")
f.Weapons.setPaused(true)
require(f.S.StructureService).setPaused(true)
require(f.S.MapService).setMovementCheck(false)
require(f.S.CombatService).protect(f.me, 10000)
require(f.S.CombatService).protect(f.peer, 10000)
describe("Plant boost eligibility", function()
	it("boosts the small plant but never its scene-disabled mother", function()
		Enemy.killAll()
		assert(Enemy.spawn("CorruptedBuffer", 40, 30, 1, 1, nil, nil, 0, 1))
		local mother = assert(Enemy.spawn("CarnivorousPlantMother", 41, 30, 1, 1, nil, nil, 0, 1))
		local child = assert(Enemy.spawn("CarnivorousPlant", 42, 30, 1, 1, nil, nil, 0, 1))
		f.world.advance(0.3, 1 / 60)
		expect(Enemy.getMaxHealth(mother)).toBe(35)
		expect(Enemy.getMaxHealth(child)).toBe(18)
		expect(#f.world.errors).toBe(0)
	end)
end)
