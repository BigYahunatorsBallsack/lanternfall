--!strict
-- Source shooting movement locks start on the next physics callback and end with the selected behavior's recovery.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local S = require(Shared.Util.NativeBossShooting)
local function fixed()
	return 0.5
end
local function make(recovery)
	local r = table.clone(require(Shared.Config.NativeSilesaurus).shootingRules)
	r.profiles = table.clone(r.profiles)
	r.profiles[1] = table.clone(r.profiles[1])
	r.profiles[1].moveLocked = true
	r.profiles[1].recoveryFrames = recovery
	return S.new(r, fixed)
end
describe("Native boss movement lock", function()
	it("starts the source animation before locking movement on its following physics callback", function()
		local state = make(35)
		assert(S.physics(state, 1, 10))
		expect(S.isMovementLocked(state)).toBe(false)
		S.physics(state, 1 / 60, 10)
		expect(S.isMovementLocked(state)).toBe(true)
	end)
	it("keeps the actor locked during its original35frame recovery and unlocks at zero", function()
		local state = make(35)
		S.physics(state, 1, 10)
		S.physics(state, 1 / 60, 10)
		S.advanceAnimation(state, 1, fixed)
		expect(state.clocks[1].recovery).toBe(35)
		S.physics(state, 34 / 60, 10)
		expect(S.isMovementLocked(state)).toBe(true)
		S.physics(state, 1 / 60, 10)
		expect(S.isMovementLocked(state)).toBe(false)
	end)
	it("releases a zero-recovery locked attack on animation finish", function()
		local state = make(0)
		S.physics(state, 1, 10)
		S.physics(state, 1 / 60, 10)
		assert(S.isMovementLocked(state))
		S.advanceAnimation(state, 1, fixed)
		expect(S.isMovementLocked(state)).toBe(false)
	end)
	it("preserves the source locked flag across a phase callback until the current attack releases it", function()
		local state = make(35)
		S.physics(state, 1, 10)
		S.physics(state, 1 / 60, 10)
		S.phaseChanged(state)
		expect(state.movement.canMove).toBe(true)
		expect(S.isMovementLocked(state)).toBe(true)
		S.advanceAnimation(state, 1, fixed)
		S.physics(state, 35 / 60, 10)
		expect(S.isMovementLocked(state)).toBe(false)
	end)
end)
