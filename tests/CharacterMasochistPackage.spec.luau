--!strict
-- Native character starting alternatives, complete core rules and personal unlock boundary in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Masochist")
describe("Native Masochist package", function()
	it("runs all22 original starts", function()
		f.starts(22)
	end)
	it("gains5Damage per actual hurt until wave end and restores the wave-start bonus on retry", function()
		f.start("Scissors")
		local Combat = require(f.S.CombatService)
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(20)
		expect(f.Stats.getStat(f.me, "hpRegen")).toBe(20)
		expect(f.Stats.getStat(f.me, "armor")).toBe(8)
		expect(f.Stats.getStat(f.me, "damage")).toBe(-100)
		Combat.drainPlayer(f.me, 1)
		Combat.drainPlayer(f.me, 1)
		expect(f.Stats.getStat(f.me, "damage")).toBe(-90)
		expect(f.Stats.getStat(f.peer, "damage")).toBe(0)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		expect(f.Stats.getStat(f.me, "damage")).toBe(-100)
		Combat.drainPlayer(f.me, 1)
		f.Run.skipTo(require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt)
		expect(f.Stats.getStat(f.me, "damage")).toBe(-100)
	end)
	it("requires a saved Danger3 victory", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).stats.bestDanger = 2
		expect(A.characterUnlocked(f.Data.get(f.peer), "Masochist")).toBe(false)
		f.Data.get(f.peer).stats.bestDanger = 3
		expect(A.characterUnlocked(f.Data.get(f.peer), "Masochist")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
