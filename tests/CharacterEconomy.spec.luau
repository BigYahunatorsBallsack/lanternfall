--!strict
-- Native character economy policy boundaries from stable PC source, independent of UI access/artwork.
local Shared = game:GetService("ReplicatedStorage").Shared
local Rules = require(Shared.Util.CharacterRules)
local Economy = require(Shared.Util.CharacterEconomy)
describe("Native character economy", function()
	it("reads only additive direct effects and retains original signed amounts", function()
		expect(Rules.nativeAmount("Farmer", "harvesting_growth")).toBe(3)
		expect(Rules.nativeAmount("Farmer", "gold_drops")).toBe(-50)
		expect(Rules.nativeAmount("Explorer", "enemy_gold_drops")).toBe(-50)
		expect(Rules.nativeAmount("Entrepreneur", "recycling_gains")).toBe(25)
		expect(Rules.nativeAmount("Entrepreneur", "gain_pct_gold_start_wave")).toBe(-100)
		expect(Rules.nativeAmount("Unknown", "gold_drops")).toBe(0)
	end)
	it("averages each co-op drop modifier toward zero before combining it and preserves the native floor", function()
		expect(Economy.materialCount(10, { "Farmer" }, true, 0.5)).toBe(5)
		expect(Economy.materialCount(10, { "Jack" }, true, 0.5)).toBe(30)
		expect(Economy.materialCount(10, { "Farmer", "Jack" }, true, 0.5)).toBe(17)
		expect(Economy.materialCount(1, { "Explorer" }, true, 0.49)).toBe(1)
		expect(Economy.materialCount(1, { "Explorer" }, true, 0.5)).toBe(0)
		expect(Economy.materialCount(1, { "Explorer" }, false, 0.99)).toBe(1)
	end)
	it("applies recycling gains as additive percentage points and clamps the native price", function()
		expect(Economy.recyclingPrice(100, 100, 0)).toBe(25)
		expect(Economy.recyclingPrice(100, 100, 25)).toBe(50)
		expect(Economy.recyclingPrice(75, 75, 25)).toBe(37)
		expect(Economy.recyclingPrice(100, 75, 25)).toBe(50)
		expect(Economy.recyclingPrice(100, 20, 25)).toBe(20)
		expect(Economy.recyclingPrice(2, 2, -100)).toBe(1)
	end)
	it("grows Farmer by eight percent and decreases harvesting by twenty percent in endless", function()
		expect(Economy.harvestingGrowth("Farmer", 101, 20)).toBe(9)
		expect(Economy.harvestingGrowth("Crazy", 101, 20)).toBe(6)
		expect(Economy.harvestingGrowth("Farmer", 101, 21)).toBe(-21)
		expect(Economy.harvestingGrowth("Farmer", 0, 20)).toBe(0)
		expect(Economy.harvestingGrowth("Farmer", -10, 20)).toBe(0)
	end)
end)
