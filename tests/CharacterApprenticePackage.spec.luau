--!strict
-- Native starting alternatives, personal production-service rules and original challenge boundary.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("CandleScholar")
local E = require(f.S.ExperienceService)
local function level(player)
	local p = E.getProgress(player)
	assert(E.addXp(p.needed - p.xp, player))
end
describe("Native Apprentice package", function()
	it("adopts all29 original starts while retaining CandleScholar", function()
		expect(f.wasLegacy).toBe(true)
		expect(f.class.displayName).toBe("Apprentice")
		f.starts(29)
	end)
	it("applies personal level gains and rolls them back with the failed wave", function()
		f.start("RitualDirk")
		level(f.me)
		expect(f.Stats.getLevel(f.me)).toBe(1)
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(9)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(2)
		for _, id in { "rangedDamage", "elementalDamage", "engineering" } do
			expect(f.Stats.getStat(f.me, id)).toBe(1)
		end
		expect(f.Stats.getLevel(f.peer)).toBe(0)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		expect(f.Stats.getLevel(f.me)).toBe(0)
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(10)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(0)
	end)
	it("unlocks at personal level20 rather than the highest teammate level", function()
		local A = require(f.Shared.Util.CharacterAccess)
		for _ = 1, 19 do
			level(f.peer)
		end
		expect(f.Stats.getLevel(f.peer)).toBe(19)
		expect(A.characterUnlocked(f.Data.get(f.peer), "CandleScholar")).toBe(false)
		level(f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "CandleScholar")).toBe(true)
		expect(f.Stats.getLevel(f.me)).toBe(0)
		expect(#f.world.errors).toBe(0)
	end)
end)
