--!strict
-- Source shared shoot animation routes method/finish to the current profile while inactive attack clocks remain frozen.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local function modules()
	return require(Shared.Util.NativeBossShooting), require(Shared.Config.NativeBossPhases).therizinosaurusShooting
end
local function fixed()
	return 0.5
end
describe("Native shared boss shoot animation", function()
	it("initializes both original Therizinosaurus clocks without selecting or advancing the child", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		expect(state.current).toBe(1)
		expect(state.clocks[1].initial).toBe(10)
		expect(state.clocks[1].remaining).toBe(5)
		expect(state.clocks[2].initial).toBe(30)
		expect(state.clocks[2].remaining).toBe(12)
		S.physics(state, 1 / 60, 1)
		expect(state.clocks[1].initial).toBeNear(9)
		expect(state.clocks[2].initial).toBe(30)
	end)
	it("returns for the entire initial-cooldown frame before starting ordinary cooldown", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		expect(S.physics(state, 1, 1)).toBe(false)
		expect(state.clocks[1].initial).toBe(0)
		expect(state.clocks[1].remaining).toBe(5)
		expect(S.physics(state, 5 / 60, 1)).toBe(true)
		expect(state.animation.speed).toBe(3)
	end)
	it("routes an in-flight method event to the newly selected bullet attack, not the old slash", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		S.physics(state, 10 / 60, 1)
		S.physics(state, 5 / 60, 1)
		S.advanceAnimation(state, 0.1, fixed)
		S.select(state, 2)
		local shots = S.advanceAnimation(state, 1 / 6, fixed)
		expect(#shots).toBe(1)
		expect(shots[1]).toBe(2)
		expect(state.clocks[1].shots).toBe(0)
		expect(state.clocks[2].shots).toBe(1)
		expect(state.animation.speed).toBe(3) -- speed belongs to the already playing animation
		expect(state.clocks[2].initial).toBe(30)
	end)
	it("routes animation finish to the current attack and keeps an inactive clock intact", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		S.physics(state, 10 / 60, 1)
		S.physics(state, 5 / 60, 1)
		state.clocks[1].remaining = 2
		S.select(state, 2)
		state.clocks[2].remaining = 0
		local shots = S.advanceAnimation(state, 1 / 3, fixed)
		expect(shots[1]).toBe(2)
		expect(state.animation.playing).toBe(false)
		expect(state.clocks[1].remaining).toBe(2)
		expect(state.clocks[2].remaining).toBe(12)
	end)
	it("can select another profile between the actual method and finish callbacks", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		S.physics(state, 10 / 60, 1)
		S.physics(state, 5 / 60, 1)
		local invoked
		S.advanceAnimation(state, 1 / 3, fixed, function(index)
			invoked = index
			S.select(state, 2)
		end)
		expect(invoked).toBe(1)
		expect(state.clocks[1].shots).toBe(1)
		expect(state.clocks[2].shots).toBe(0)
		expect(state.clocks[2].remaining).toBe(12)
	end)
	it("applies the child attack's original three-shot long cooldown on animation finish", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		S.select(state, 2)
		state.clocks[2].initial = 0
		for shot = 1, 3 do
			expect(S.physics(state, 12 / 60, 1)).toBe(true)
			local fired = S.advanceAnimation(state, 2 / 3, fixed)
			expect(fired[1]).toBe(2)
			if shot < 3 then
				expect(state.clocks[2].shots).toBe(shot)
			end
		end
		expect(state.clocks[2].remaining).toBe(150)
		expect(state.clocks[2].shots).toBe(0)
	end)
	it("counts cooldown outside inclusive attack range without starting an animation", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		state.clocks[1].initial = 0
		expect(S.physics(state, 1, rules.profiles[1].maxRange + 1)).toBe(false)
		expect(state.clocks[1].remaining).toBe(0)
		expect(S.physics(state, 0, rules.profiles[1].maxRange)).toBe(true)
	end)
	it("does not refire the method track or reset the shared animation when a behavior resets", function()
		local S, rules = modules()
		local state = S.new(rules, fixed)
		state.clocks[1].initial = 0
		S.physics(state, 1, 1)
		S.advanceAnimation(state, 0.27, fixed)
		S.resetCurrent(state, fixed)
		expect(state.clocks[1].initial).toBe(10)
		expect(state.clocks[1].shots).toBe(0)
		expect(state.animation.playing).toBe(true)
		expect(#S.advanceAnimation(state, 0.01, fixed)).toBe(0)
	end)
end)
