--!strict
-- Full native starts, source mechanics and personal challenge boundaries through production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("King")
describe("Native King package", function()
	it("runs all42 original tierII starts", function()
		f.starts(42)
	end)
	it("recomputes weapon tier bonuses and counts distinct item identities by rarity", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "luck")).toBe(50)
		expect(f.Stats.getStat(f.me, "damage")).toBe(0)
		local weapon = f.Weapons.getWeapons(f.me)[1]
		assert(f.Weapons.raiseTier(f.me, weapon.uid))
		expect(f.Stats.getStat(f.me, "damage")).toBe(0)
		assert(f.Weapons.raiseTier(f.me, weapon.uid))
		expect(f.Stats.getStat(f.me, "damage")).toBe(25)
		expect(f.Stats.getStat(f.me, "attackSpeed")).toBe(25)
		assert(f.Weapons.addWeapon(f.me, "BrassKnuckles", 1))
		expect(f.Stats.getStat(f.me, "damage")).toBe(10)
		expect(f.Stats.getStat(f.me, "attackSpeed")).toBe(10)
		for _, w in f.Weapons.getWeapons(f.me) do
			if w.id == "BrassKnuckles" then
				f.Weapons.removeWeapon(f.me, w.uid)
			end
		end
		expect(f.Stats.getStat(f.me, "damage")).toBe(25)
		assert(f.Stats.addItem(f.me, "CrackedLens"))
		assert(f.Stats.addItem(f.me, "CrackedLens"))
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(8)
		assert(f.Stats.addItem(f.me, "Focus"))
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(6)
		assert(f.Stats.addItem(f.me, "FieldCenser"))
		assert(f.Stats.addItem(f.me, "FieldCenser"))
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(11)
		assert(f.Stats.addItem(f.me, "LoneFlame"))
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(16)
	end)
	it("requires three simultaneous tierIV weapons, including same-family copies", function()
		local A = require(f.Shared.Util.CharacterAccess)
		assert(f.Weapons.addWeapon(f.peer, "WatchmanPistol", 4))
		assert(f.Weapons.addWeapon(f.peer, "WatchmanPistol", 4))
		expect(A.characterUnlocked(f.Data.get(f.peer), "King")).toBe(false)
		assert(f.Weapons.addWeapon(f.peer, "WatchmanPistol", 4))
		expect(A.characterUnlocked(f.Data.get(f.peer), "King")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
