--!strict
-- Saver's27 starts, Piggy Bank, actual wallet conversion, source cutoff and lifetime material unlock.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Saver")
local Shop = require(f.S.ShopService)
describe("Native Saver package", function()
	it("runs all27 native starts with exactly one Piggy Bank", function()
		f.starts(27, { TitheBox = 1 })
	end)
	it(
		"tracks the current personal wallet including spending and compounds native interest once at wave start",
		function()
			f.start("BrassKnuckles")
			Shop.addShards(f.me, 123 - Shop.getShards(f.me))
			f.world.advance(0.1)
			expect(f.Stats.getStat(f.me, "damage")).toBe(4)
			expect(f.Stats.getStat(f.me, "harvesting")).toBe(15)
			expect(f.Stats.getStat(f.me, "itemPrice")).toBe(50)
			assert(Shop.spendShards(f.me, 24))
			f.world.advance(0.1)
			expect(f.Stats.getStat(f.me, "damage")).toBe(3)
			expect(f.Stats.getStat(f.peer, "damage")).toBe(0)
			f.nextWave()
			expect(f.Run.getWave()).toBe(2)
			expect(Shop.getShards(f.me)).toBe(136) --99 held +15 Harvesting, then floor(114*.20)
			Shop.addShards(f.me, 100)
			f.Run.setParticipantState(f.me, "Down")
			f.Run.setParticipantState(f.peer, "Down")
			f.world.advance(0.1)
			assert(f.Run.retryWave(f.peer))
			expect(Shop.getShards(f.me)).toBe(136)
		end
	)
	it("keeps Piggy Bank active through wave20 and stops in endless wave21", function()
		local Rules = require(f.S.EffectService.EffectRules)
		local entry =
			{ key = "TitheBox#1", itemId = "TitheBox", count = 1, effect = f.Config.Items.byId.TitheBox.effects[1] }
		local buffs = Rules.newBuffs()
		expect(Rules.matches(entry, { trigger = "WaveStart", wave = 20 }, buffs)).toBe(true)
		expect(Rules.matches(entry, { trigger = "WaveStart", wave = 21 }, buffs)).toBe(false)
	end)
	it("unlocks from20000 personally collected material objects rather than held currency", function()
		local Access = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).nativeCounts.materialsCollected = 19998
		f.Data.observeNativeMaterials(f.peer, 1)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Saver")).toBe(false)
		f.Data.observeNativeMaterials(f.peer, 1)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "Saver")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
