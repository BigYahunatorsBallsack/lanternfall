--!strict
-- Native character starting alternatives, complete core rules and personal unlock boundary in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Golem")
describe("Native Golem package", function()
	it("runs all24 original starts", function()
		f.starts(24)
	end)
	it("uses native gains, blocks healing, and activates below strictly half HP", function()
		f.start("RitualDirk")
		local Combat = require(f.S.CombatService)
		expect(Combat.getHp(f.me)).toBe(39)
		expect(f.Stats.getStat(f.me, "maxHp")).toBeNear(39.9)
		Combat.drainPlayer(f.me, 19)
		expect(f.Stats.getStat(f.me, "attackSpeed")).toBe(0)
		Combat.drainPlayer(f.me, 1)
		expect(f.Stats.getStat(f.me, "attackSpeed")).toBe(40)
		expect(f.Stats.getStat(f.me, "speed")).toBe(20)
		expect(Combat.healPlayer(f.me, 100)).toBe(0)
		f.Stats.addStats(f.me, { armor = 3 })
		expect(f.Stats.getStat(f.me, "armor")).toBeNear(3.99)
	end)
	it("grants Reckless only to the living player finishing a wave at exactly1HP before healing", function()
		local A = require(f.Shared.Util.CharacterAccess)
		local Combat = require(f.S.CombatService)
		Combat.drainPlayer(f.peer, 8)
		f.Run.skipTo(require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Golem")).toBe(false)
		f.nextWave()
		Combat.drainPlayer(f.peer, Combat.getHp(f.peer) - 1)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Golem")).toBe(false)
		f.Run.skipTo(require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Golem")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
