--!strict
-- Infected eggs hatch into one real Mad Slasher, die with native credit, preserve source spawn factors and inherit Charm.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("NightWatch")
local Enemy = require(f.S.EnemySim)
f.start("WatchmanPistol")
f.Weapons.setPaused(true)
for _, p in { f.me, f.peer } do
	require(f.S.CombatService).protect(p, 1000)
end
local function clear()
	Enemy.killAll()
	f.world.advance(0.1)
	Enemy.killAll()
end
describe("Native Infected Slasher Egg", function()
	it("uses the native5.6second hatch and a real kill/death event instead of silently removing the shell", function()
		local kind = f.Config.Enemies.types.InfectedSlasherEgg
		expect(kind.hatch.seconds).toBe(5.6)
		expect(kind.hatch.nativeDeath).toBe(true)
		expect(kind.hatch.enemy).toBe("MadSlasher")
		expect(kind.hatch.count).toBe(1)
	end)
	it("spawns precisely one source-grown Mad Slasher and credits the egg death once", function()
		clear()
		local id = assert(Enemy.spawn("InfectedSlasherEgg", 0, 0, 2, 3, nil, nil, 0, 10))
		local events = {}
		local connection = Enemy.EnemyKilled:Connect(function(info)
			table.insert(events, info)
		end)
		f.world.advance(5.4, 1 / 60)
		expect(Enemy.isAlive(id)).toBe(true)
		f.world.advance(0.3, 1 / 60)
		expect(Enemy.isAlive(id)).toBe(false)
		local ids = {}
		Enemy.collectIds(ids)
		expect(#ids).toBe(1)
		expect(Enemy.getKind(ids[1])).toBe("MadSlasher")
		expect(Enemy.getMaxHealth(ids[1])).toBe(790)
		expect(#events).toBe(1)
		expect(events[1].enemyId).toBe("InfectedSlasherEgg")
		expect(events[1].xp).toBe(1)
		expect(events[1].killer).toBe(nil)
		connection:Disconnect()
	end)
	it("never hatches a shell destroyed before the animation method", function()
		clear()
		local id = assert(Enemy.spawn("InfectedSlasherEgg", 0, 0, 1, 0, nil, nil, 0, 1))
		Enemy.damage(id, 1e6, f.me)
		f.world.advance(6, 1 / 60)
		expect(Enemy.getCount()).toBe(0)
	end)
	it("keeps the parent faction and grants the child a fresh native Charm lifetime", function()
		clear()
		local id = assert(Enemy.spawn("InfectedSlasherEgg", 0, 0, 100, 0, nil, nil, 0, 1))
		Enemy.damage(id, 1, nil)
		assert(Enemy.tryCharm(f.me, id, { charmChance = 1, charmThreshold = 1 }, function()
			return 0
		end))
		f.world.advance(5.7, 1 / 60)
		expect(Enemy.isCharmed(id)).toBe(false)
		expect(Enemy.getCharmedCount(f.me.UserId)).toBe(1)
		local ids = {}
		Enemy.collectAllIds(ids)
		expect(#ids).toBe(1)
		expect(Enemy.getKind(ids[1])).toBe("MadSlasher")
		expect(Enemy.isCharmed(ids[1])).toBe(true)
		f.world.advance(2.5, 1 / 60)
		expect(Enemy.getCharmedCount(f.me.UserId)).toBe(1)
		expect(#f.world.errors).toBe(0)
	end)
end)
