--!strict
-- Production Catling Gun deployments freeze during native boosting and fire actual swept pet projectiles.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("NightWatch")
local Structures, Enemy = require(f.S.StructureService), require(f.S.EnemySim)
local Map = require(f.S.MapService)
local function find()
	for _, row in Structures.getSnapshot() do
		if row.kind == "CatlingGun" then
			return row
		end
	end
	error("Missing Catling Gun")
end
local function start()
	Structures.setPaused(true)
	f.start("WatchmanPistol")
	assert(f.Stats.addItem(f.me, "CatlingGun"))
	f.nextWave()
	f.Weapons.setPaused(true)
	Map.setMovementCheck(false)
	local y = f.Config.Map.arena.center.Y
	f.me.Character.HumanoidRootPart.Position = Vector3.new(70, y, 70)
	f.peer.Character.HumanoidRootPart.Position = Vector3.new(-70, y, -70)
	return y
end
describe("Native Catling Gun actors", function()
	it("deploys one pet without increasing structure or turret source counts", function()
		start()
		expect(find().ownerId).toBe(f.me.UserId)
		expect(Structures.petSourceCount(f.me)).toBe(1)
		expect(Structures.sourceCount(f.me)).toBe(0)
		expect(Structures.turretSourceCount(f.me)).toBe(0)
		expect(f.Config.Items.byId.CatlingGun.available).toBe(false)
	end)
	it("wanders without a booster, holds still near a player and resumes after they leave", function()
		local before = find()
		Structures.setPaused(false)
		f.world.advance(0.3, 1 / 60)
		local moving = find()
		expect(math.abs(moving.x - before.x) + math.abs(moving.z - before.z) > 0.1).toBe(true)
		f.peer.Character.HumanoidRootPart.Position = Vector3.new(moving.x, f.Config.Map.arena.center.Y, moving.z)
		f.world.advance(0.2, 1 / 60)
		local stopped = find()
		f.world.advance(0.5, 1 / 60)
		local held = find()
		expect(held.x).toBeNear(stopped.x)
		expect(held.z).toBeNear(stopped.z)
		f.peer.Character.HumanoidRootPart.Position = Vector3.new(-70, f.Config.Map.arena.center.Y, -70)
		f.world.advance(0.3, 1 / 60)
		local resumed = find()
		expect(math.abs(resumed.x - held.x) + math.abs(resumed.z - held.z) > 0.1).toBe(true)
	end)
	it("hits enemies with live bullets while its owner is down and clears on run end", function()
		local y = start()
		local row = find()
		f.peer.Character.HumanoidRootPart.Position = Vector3.new(row.x, y, row.z)
		require(f.S.CombatService).drainPlayer(f.me, 100000)
		local id = assert(Enemy.spawn("Brute", row.x + 20, row.z, 100, 0, nil, nil, 0))
		local hp = Enemy.getHealth(id)
		Structures.setPaused(false)
		f.world.advance(1.5, 1 / 60)
		expect(Enemy.getHealth(id) < hp).toBe(true)
		expect(f.Run.getParticipantState(f.me)).toBe("Down")
		f.Run.endRun("Abandoned")
		expect(#Structures.getSnapshot()).toBe(0)
		expect(#f.world.errors).toBe(0)
	end)
end)
