--!strict
-- Effective original weapon stats: damage layers, HP conversion, timing, combat and burn/explosion modifiers.
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local WeaponStats = require(game:GetService("ServerScriptService").Server.Services.WeaponService.WeaponStats)
local function compute(id, tier, bonuses)
	return WeaponStats.compute(Config.Weapons[id], tier, bonuses or {}, nil, Config.Player.minWeaponCooldown)
end

describe("WeaponStats", function()
	it("adds flat scaling before Damage percent", function()
		expect(compute("WatchmanPistol", 1, { rangedDamage = 3, damage = 20, meleeDamage = 50 }).damage).toBeNear(18)
		expect(compute("RitualDirk", 4, { meleeDamage = 10 }).damage).toBeNear(33)
		expect(compute("RattleRepeater", 4, { rangedDamage = 10 }).damage).toBeNear(16)
	end)
	it("clamps negative damage to one", function()
		expect(compute("WatchmanPistol", 1, { rangedDamage = -100, damage = -90 }).damage).toBe(1)
	end)
	it("scales cooldowns and enforces the engine attack cap", function()
		expect(compute("WatchmanPistol", 1, { attackSpeed = 100 }).cooldown).toBeNear(0.6)
		expect(compute("WatchmanPistol", 1, { attackSpeed = -100 }).cooldown).toBeNear(2.4)
		expect(compute("WatchmanPistol", 1, { attackSpeed = 100000 }).cooldown).toBe(
			Config.Combat.originalWeapons.minCooldown
		)
	end)
	it("converts Range and halves only the melee bonus", function()
		expect(compute("WatchmanPistol", 1, { range = 50 }).range).toBeNear(45)
		expect(compute("RitualDirk", 1, { range = 50 }).range).toBeNear(17.5)
		expect(compute("WatchmanPistol", 1, { range = -100000 }).range).toBe(Config.Stats.range.minStuds)
	end)
	it("adds crit and lifesteal to weapon-specific values", function()
		expect(compute("RitualDirk", 4, { critChance = 20 }).critChance).toBeNear(0.7)
		expect(compute("OrbitBlades", 2, { lifeSteal = 5 }).lifeSteal).toBeNear(0.5)
		expect(compute("OrbitBlades", 4).lifeSteal).toBeNear(0.6)
		expect(compute("RitualDirk", 1, { critChance = -50 }).critChance).toBe(0)
		expect(compute("RitualDirk", 1, { critChance = 500 }).critChance).toBe(1)
	end)
	it("adds knockback and converts its units", function()
		expect(compute("RitualDirk", 1, { knockback = 5 }).knockback).toBeNear(
			7 * Config.Combat.knockback.studsPerPoint
		)
		expect(compute("RitualDirk", 1, { knockback = -5 }).knockback).toBe(0)
	end)
	it("combines source piercing and bouncing with secondary stats", function()
		local s = compute("WatchmanPistol", 1, { piercing = 2, piercingDamage = 15, bounce = 1 })
		expect(s.pierce).toBe(3)
		expect(s.pierceDamage).toBeNear(0.65)
		expect(s.bounce).toBe(1)
		expect(compute("Obliterator", 3, { piercing = 10 }).pierce).toBe(-1)
		expect(compute("Obliterator", 3, { piercing = 10 }).pierceDamage).toBe(1)
	end)
	it("grows explosions with size and damage", function()
		local s = compute("MortarLantern", 4, { explosionSize = 50, explosionDamage = 20 })
		expect(s.explosionRadius).toBeNear(7.2 * 1.5)
		expect(s.explosionDamage).toBeNear(1.2)
	end)
	it("scales burns with Elemental Damage and burn speed/spread", function()
		local s = compute("Torch", 1, { elementalDamage = 2, damage = 50, burnSpeed = 20, burnSpread = 1 })
		expect(s.burnDamage).toBeNear(7.5)
		expect(s.burnInterval).toBeNear(Config.Combat.burn.tickSeconds * 0.8)
		expect(s.burnSpread).toBe(1)
		expect(WeaponStats.ownerDamage(1, { elementalDamage = 1 }, { elementalDamage = 4, damage = -50 })).toBeNear(2.5)
	end)
	it("scales on-hit projectiles with their own source stat", function()
		expect(compute("CactiClub", 1, { rangedDamage = 10, damage = 50 }).secondaryDamage).toBeNear(10.5)
		expect(compute("ChainLightning", 4, { elementalDamage = 10 }).secondaryDamage).toBeNear(19)
		expect(compute("SniperGun", 4, { range = 100 }).secondaryDamage).toBeNear(20)
	end)
end)
