--!strict
-- Native set counts in actual StatService recomputation, personal isolation and inventory changes.
local world = loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Server = game:GetService("ServerScriptService").Server
runScript(Server, "init.server.luau")
local S = Server.Services
local Run = require(S.RunDirector)
local Stats = require(S.StatService)
local Weapons = require(S.WeaponService)
local me = world.addPlayer("OneArmed", 1, true)
local peer = world.addPlayer("Vagabond", 2, false)
world.advance(0.5)
local Client = folderProxy("src/client", "Client")
runScript(Client, "init.client.luau")
Config.Classes.Vagabond.available = true
require(S.PlayerDataService).unlockAll(me)
require(S.PlayerDataService).unlockAll(peer)
assert(Run.selectClass(me, "SoleConductor"))
assert(Run.selectClass(peer, "Vagabond"))
require(S.SpawnDirector).setPaused(true)
Weapons.setPaused(true)
Run.setHoldWaves(true)
Run.setReady(me, true)
Run.setReady(peer, true)
world.advance(3.5)
for _, player in { me, peer } do
	for _, weapon in Weapons.getWeapons(player) do
		assert(Weapons.removeWeapon(player, weapon.uid))
	end
end
describe("Native set integration", function()
	it("applies the actual four-count bonus to one One Armed weapon and isolates its peer", function()
		assert(Weapons.addWeapon(me, "SpiritFlint"))
		expect(Stats.getStat(me, "dodge")).toBe(18)
		expect(Stats.getStat(me, "armor")).toBe(-3)
		expect(Stats.getStat(peer, "dodge")).toBe(-5)
	end)
	it("recomputes Vagabond's held sets from every weapon when a distinct weapon is removed", function()
		assert(Weapons.addWeapon(peer, "SpiritFlint"))
		assert(Weapons.addWeapon(peer, "WatchmanPistol"))
		local ok, _, uid = Weapons.addWeapon(peer, "RitualDirk")
		assert(ok)
		expect(Stats.getStat(peer, "dodge")).toBe(7)
		expect(Stats.getStat(peer, "armor")).toBe(-7)
		assert(Weapons.removeWeapon(peer, uid))
		expect(Stats.getStat(peer, "dodge")).toBe(1)
		expect(Stats.getStat(peer, "armor")).toBe(-6)
		expect(Stats.getStat(me, "dodge")).toBe(18)
		expect(#world.errors).toBe(0)
	end)
	it("shows the server's native set count in the actual secondary stat panel", function()
		Run.skipTo(require(Shared.Util.RunSchedule).wave(Run.getWave()).endsAt)
		require(Client.Controllers.StatsController).setPage("Secondary")
		local row = world.gui("Stats", "Spectral")
		assert(row)
		expect(row.Text:find("4/6", 1, true) ~= nil).toBe(true)
		expect(#world.errors).toBe(0)
	end)
end)
