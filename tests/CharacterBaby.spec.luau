--!strict
-- Baby slot cards grant capacity on selection, never at XP receipt, and selected slots survive wave retry.
local world = loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Server = game:GetService("ServerScriptService").Server
runScript(Server, "init.server.luau")
local S = Server.Services
local Run = require(S.RunDirector)
local Weapons = require(S.WeaponService)
local XP = require(S.ExperienceService)
local Upgrades = require(S.UpgradeService)
local Stats = require(S.StatService)
local me = world.addPlayer("Owner", 1, true)
world.advance(0.5)
Config.Classes.Baby.available = true
require(S.PlayerDataService).unlockAll(me)
world.fireServerAs(me, "SelectClass", "Baby")
require(S.SpawnDirector).setPaused(true)
Weapons.setPaused(true)
Run.setHoldWaves(true)
Run.setReady(me, true)
world.advance(3.5)
require(S.EnemySim).killAll()

describe("Baby slot progression", function()
	it("waits for the actual slot-card choice, validates the choice and grants one slot", function()
		expect(Weapons.getMaxWeapons(me)).toBe(1)
		XP.grantLevel()
		expect(Weapons.getMaxWeapons(me)).toBe(1)
		Run.skipTo(require(Shared.Util.RunSchedule).wave(Run.getWave()).endsAt)
		local offer = assert(Upgrades.getOffer(me))
		expect(#offer).toBe(1)
		expect(offer[1].stat).toBe("weaponSlots")
		world.fireServerAs(me, "ChooseUpgrade", "Stat:damage:4")
		expect(Weapons.getMaxWeapons(me)).toBe(1)
		world.advance(0.3)
		world.fireServerAs(me, "ChooseUpgrade", offer[1].id)
		expect(Weapons.getMaxWeapons(me)).toBe(2)
		expect(Stats.getStat(me, "weaponSlots")).toBe(1)
		expect(Upgrades.getOffer(me)).toBe(nil)
	end)

	it("restores selected slots and removes later grants when retrying the wave", function()
		world.fireServerAs(me, "SetShopReady", true)
		world.advance(0.2)
		Stats.addUpgrade(me, "weaponSlots", 3)
		expect(Weapons.getMaxWeapons(me)).toBe(5)
		Run.setParticipantState(me, "Down")
		assert(Run.retryWave(me))
		world.advance(0.1)
		expect(Weapons.getMaxWeapons(me)).toBe(2)
		expect(Stats.getStat(me, "weaponSlots")).toBe(1)
	end)
end)
