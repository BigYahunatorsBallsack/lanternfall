--!strict
-- Native character starting alternatives, complete core rules and personal unlock boundary in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Mutant")
describe("Native Mutant package", function()
	it("runs all26 original starts", function()
		f.starts(26)
	end)
	it("retains fractional34% XP thresholds and50% item price", function()
		f.start("Revolver")
		local XP = require(f.S.ExperienceService)
		expect(XP.getProgress(f.me).needed).toBeNear(5.44)
		expect(f.Stats.getStat(f.me, "itemPrice")).toBe(50)
		assert(XP.addXp(5, f.me))
		expect(XP.getLevel(f.me)).toBe(0)
		assert(XP.addXp(1, f.me))
		expect(XP.getLevel(f.me)).toBe(1)
		expect(XP.getProgress(f.me).xp).toBeNear(0.56)
		expect(XP.getLevel(f.peer)).toBe(0)
	end)
	it("unlocks personally after2000 lifetime enemy kills", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).nativeCounts.enemiesKilled = 1998
		f.Data.observeNativeEnemyKill(f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Mutant")).toBe(false)
		f.Data.observeNativeEnemyKill(f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Mutant")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
