--!strict
-- Registered normal Dimetrodon must bind the checked native jump, patrol, death/landing shots and original body facts.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Config)
local Kinds = require(Shared.Util.EnemyKinds)
local C = require(Shared.Config.NativeDimetrodon)
local Facts = require(Shared.Config.JungleWalkers)
describe("Registered normal Dimetrodon", function()
	it("registers one source-bound normal body without exposing Jungle or completing a character", function()
		local k = assert(Kinds.get("Dimetrodon"), "Normal Dimetrodon is not registered")
		expect(k.typeId).toBe(69)
		expect(k.nativeZoneId).toBe(2)
		expect(k.hp).toBe(5)
		expect(k.hpPerWave).toBe(2)
		expect(k.contactDamage).toBe(1)
		expect(k.damagePerWave).toBeNear(0.85)
		expect(k.speed).toBeNear(17.5)
		expect(k.speedMax).toBeNear(17.5)
		expect(k.radius).toBeNear(2.2)
		expect(k.hurtRadius).toBe(4)
		expect(k.hitRadius).toBeNear(2.4)
		expect(k.nativeHurtOffsetZ).toBeNear(-2.4)
		expect(k.nativeHitOffsetZ).toBeNear(-0.8)
		expect(k.nativeBodyOffsetZ).toBeNear(-0.8)
		expect(k.xp).toBe(2)
		expect(k.knockbackResistance).toBeNear(0.7)
		expect(k.nativeJump).toBe(C.jumpRule)
		expect(k.nativeEdgePatrol).toBe(C.patrolRule)
		expect(k.nativeRadialShots).toBe(C.radialRule)
		expect(k.nativeJumpPresentation).toBe(C.presentationRule)
		expect(k.ranged).toBe(nil)
		expect(k.slash).toBe(nil)
		expect(k.shotDamagePerWave).toBeNear(1.15)
		expect(C.actorRegistered).toBe(true)
		expect(Facts.zonePlayable).toBe(false)
		expect(Facts.enemies.Dimetrodon.sourceMd5).toBe(C.sourceMd5)
	end)
end)
