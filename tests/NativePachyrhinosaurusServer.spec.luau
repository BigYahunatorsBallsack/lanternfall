--!strict
-- Actual normal Pachyrhinosaurus emits parallel slash2 attacks through server and client, including post-parent-death and real Charm hits.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("WellRounded")
runScript(folderProxy("src/client", "Client"), "init.client.luau")
local Enemy = require(f.S.EnemySim)
local Slashes = require(f.S.NativeSlashService)
local Client = require(folderProxy("src/client", "Client").Controllers.NativeSlashController)
f.start("WatchmanPistol")
f.Weapons.setPaused(true)
require(f.S.StructureService).setPaused(true)
require(f.S.MapService).setMovementCheck(false)
require(f.S.CombatService).protect(f.me, 10000)
require(f.S.CombatService).protect(f.peer, 10000)
f.me.Character.HumanoidRootPart.Position = Vector3.new(0, 100, 0)
f.peer.Character.HumanoidRootPart.Position = Vector3.new(80, 100, 80)
local function clear()
	Enemy.killAll()
	f.world.advance(1.1, 1 / 60)
end
local function watch(source)
	local shots = {}
	local connection = f.world.getRemote("NativeSlashes").OnClientEvent:Connect(function(batch)
		for _, shot in batch.fired do
			if shot.sourceId == source then
				table.insert(shots, shot)
			end
		end
	end)
	return shots, connection
end
describe("Registered Pachyrhinosaurus slash2", function()
	it("emits actual parallel source shots and keeps them alive after the parent dies", function()
		clear()
		local id = assert(Enemy.spawn("Pachyrhinosaurus", -40, 0, 2, 2, nil, nil, 0, 10))
		expect(Enemy.getMaxHealth(id)).toBe(210)
		local _, contact = Enemy.getMultipliers(id)
		expect(contact).toBe(22)
		local shots, connection = watch(id)
		f.world.advance(2.05, 1 / 60)
		connection:Disconnect()
		expect(#shots).toBe(2)
		for index, shot in shots do
			expect(shot.variant).toBe("Forward")
			expect(shot.ownerId).toBe(nil)
			expect(shot.x).toBeNear(-40)
			expect(shot.z).toBeNear(if index == 1 then 3 else -3)
			expect(shot.dx).toBeNear(math.cos(0.05))
			expect(shot.dz).toBeNear(math.sin(if index == 1 then -0.05 else 0.05))
			expect(shot.speed).toBe(if index == 1 then 30 else 35)
		end
		expect(Client.getCount()).toBe(2)
		Enemy.damage(id, 1e9, f.me)
		f.world.advance(0.05, 1 / 60)
		expect(Slashes.getCount()).toBe(2)
		expect(Client.getCount()).toBe(2)
		f.world.advance(0.7, 1 / 60)
		expect(Slashes.getCount()).toBe(0)
		expect(Client.getCount()).toBe(0)
		expect(#f.world.errors).toBe(0)
	end)
	it("lands real hostile slash hits with independent native projectile damage", function()
		clear()
		local id = assert(Enemy.spawn("Pachyrhinosaurus", -40, 0, 1000, 2, nil, nil, 0, 10))
		local hits = 0
		local connection = Enemy.ShotHit:Connect(function(player, damage)
			expect(player).toBe(f.me)
			expect(damage).toBe(20)
			hits += 1
		end)
		f.world.advance(2.8, 1 / 60)
		connection:Disconnect()
		expect(hits).toBe(2)
		expect(Enemy.isAlive(id)).toBe(true)
		expect(f.Run.getNativeZoneId()).toBe(0)
	end)
	it("retains actual leftward parallel shots after Charm and hits a hostile through the native rectangle", function()
		clear()
		local id = assert(Enemy.spawn("Pachyrhinosaurus", 40, 0, 1000, 1, nil, nil, 0, 10))
		local target = assert(Enemy.spawn("Brute", 0, 0, 1000, 0, nil, nil, 0, 10))
		assert(Enemy.charmSummoned(id, f.me.UserId))
		local before = Enemy.getHealth(target)
		local shots, connection = watch(id)
		f.world.advance(2.8, 1 / 60)
		connection:Disconnect()
		expect(#shots).toBe(2)
		for index, shot in shots do
			expect(shot.variant).toBe("Forward")
			expect(shot.ownerId).toBe(f.me.UserId)
			expect(shot.z).toBeNear(if index == 1 then -3 else 3)
			expect(shot.dx).toBeNear(-math.cos(0.05))
		end
		expect(before - Enemy.getHealth(target)).toBe(60)
		expect(Enemy.isCharmed(id)).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
