--!strict
-- Native character starting alternatives, complete core rules and personal unlock boundary in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Cyborg")
describe("Native Cyborg package", function()
	it("runs all15 choices plus the guaranteed tierIII Minigun", function()
		expect(#f.class.startWeapons).toBe(15)
		for _, id in f.class.startWeapons do
			f.start(id)
			local w = f.Weapons.getWeapons(f.me)
			expect(#w).toBe(2)
			expect(w[1].id).toBe(id)
			expect(w[2].id).toBe("Minigun")
			expect(w[1].tier).toBe(f.class.startWeaponTiers[id])
			expect(w[2].tier).toBe(3)
		end
	end)
	it("uses the native half-wave conversion once and clears it on retry", function()
		f.start("WatchmanPistol")
		f.Stats.addStats(f.me, { rangedDamage = 4, engineering = 8, meleeDamage = 100, elementalDamage = 100 })
		expect(f.Stats.getStat(f.me, "rangedDamage")).toBe(12)
		expect(f.Stats.getStat(f.me, "engineering")).toBe(2)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(0)
		expect(f.Stats.getStat(f.me, "elementalDamage")).toBe(0)
		local half = require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt * 0.5
		f.Run.skipTo(half)
		f.world.advance(0.1)
		expect(f.Stats.getStat(f.me, "rangedDamage")).toBe(0)
		expect(f.Stats.getStat(f.me, "engineering")).toBe(26)
		f.world.advance(0.5)
		expect(f.Stats.getStat(f.me, "engineering")).toBe(26)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		expect(f.Stats.getStat(f.me, "rangedDamage")).toBe(0)
		expect(f.Stats.getStat(f.me, "engineering")).toBe(0) --upgrades were granted after the wave-start checkpoint
	end)
	it("requires10Ranged and3equipped structure sources simultaneously on one player", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Stats.addStats(f.peer, { rangedDamage = 10 })
		for _ = 1, 2 do
			assert(f.Stats.addItem(f.peer, "BrassSentry"))
		end
		expect(A.characterUnlocked(f.Data.get(f.peer), "Cyborg")).toBe(false)
		assert(f.Stats.addItem(f.peer, "BrassSentry"))
		expect(A.characterUnlocked(f.Data.get(f.peer), "Cyborg")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
