--!strict
-- Native character starts, personal source mechanics and exact persistent unlock boundary.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Vampire")
describe("Native Vampire package", function()
	it("runs all32 original starts", function()
		f.starts(32)
	end)
	it("uses rounded missing-health percentages for all three linked stats and native healing restrictions", function()
		f.start("RitualDirk")
		local C = require(f.S.CombatService)
		expect(f.Stats.getStat(f.me, "hpRegen")).toBe(-100)
		expect(f.Stats.getStat(f.me, "fruitHeal")).toBe(-100)
		expect(f.Stats.getStat(f.me, "damage")).toBe(-60)
		f.Stats.addStats(f.me, { maxHp = 2 })
		expect(C.getHp(f.me)).toBe(9)
		C.drainPlayer(f.me, 5)
		expect(C.getHp(f.me)).toBe(4)
		expect(f.Stats.getStat(f.me, "damage")).toBe(52)
		expect(f.Stats.getStat(f.me, "lifeSteal")).toBe(18)
		expect(f.Stats.getStat(f.me, "armor")).toBe(11)
		C.healPlayer(f.me, 1)
		expect(f.Stats.getStat(f.me, "damage")).toBe(28)
		expect(f.Stats.getStat(f.me, "lifeSteal")).toBe(14)
		expect(f.Stats.getStat(f.peer, "damage")).toBe(0)
	end)
	it("opens permanently at40 personal LifeSteal", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Stats.addStats(f.peer, { lifeSteal = 39 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Vampire")).toBe(false)
		f.Stats.addStats(f.peer, { lifeSteal = 1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Vampire")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
