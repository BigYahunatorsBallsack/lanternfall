--!strict
-- Native half-wave conversion snapshots permanent stats and compensates both stat-gain multipliers.
local Rules = require(game:GetService("ServerScriptService").Server.Services.CharacterService.Rules)
describe("Native Cyborg conversion", function()
	it("converts thirty permanent Ranged Damage into sixty Engineering despite the two gain multipliers", function()
		local policy = assert(Rules.compile("Cyborg"))
		local delta = Rules.halfWaveConversion(policy, { rangedDamage = 30 })
		expect(delta.rangedDamage).toBe(-10)
		expect(delta.engineering).toBe(240)
	end)
	it("skips nonpositive source values and does not invent converters for other characters", function()
		expect(next(Rules.halfWaveConversion(assert(Rules.compile("Cyborg")), { rangedDamage = -3 }))).toBe(nil)
		expect(next(Rules.halfWaveConversion(assert(Rules.compile("Crazy")), { rangedDamage = 30 }))).toBe(nil)
	end)
	it("truncates the source before chunking, then rounds the compensation for native gain factors", function()
		local delta = Rules.halfWaveConversion(assert(Rules.compile("Cyborg")), { rangedDamage = 29.9 })
		expect(delta.rangedDamage).toBe(-10)
		expect(delta.engineering).toBe(232)
	end)
end)
