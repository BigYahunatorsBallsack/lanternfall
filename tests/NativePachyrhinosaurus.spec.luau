--!strict
-- Normal Pachyrhinosaurus uses parallel forward slashes, original growth and vertical pursuit, not an ordinary fan or target-square attack.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Kinds = require(Shared.Util.EnemyKinds)
local C = require(Shared.Config.JungleWalkers)
describe("Normal Pachyrhinosaurus", function()
	it("binds the actual source normal slash2 branch and numerical actor rules", function()
		local kind = assert(Kinds.get("Pachyrhinosaurus"))
		expect(kind.typeId).toBe(67)
		expect(kind.hp).toBe(15)
		expect(kind.hpPerWave).toBe(10)
		expect(kind.nativeSpeedPoints.base).toBe(275)
		expect(kind.nativeSpeedPoints.randomization).toBe(25)
		expect(kind.xp).toBe(4)
		expect(kind.knockbackResistance).toBeNear(0.7)
		expect(kind.radius).toBe(4)
		expect(kind.hurtRadius).toBe(3.5)
		expect(kind.nativeHurtOffsetZ).toBeNear(-2.9)
		expect(kind.nativeHitOffsetZ).toBeNear(-2.3)
		expect(kind.nativeFollowXShare).toBeNear(0.5)
		expect(kind.wander).toBe(nil)
		expect(kind.stayInRange).toBe(nil)
		expect(kind.ranged.nativePillar).toBe(false)
		expect(kind.ranged.nativeForwardSlash).toBe(true)
		expect(kind.ranged.nativeVolley.count).toBe(2)
		expect(kind.ranged.nativeVolley.parallel.spacing).toBe(6)
		expect(kind.ranged.nativeVolley.parallel.angleOffset).toBeNear(0.05)
		expect(kind.ranged.nativeVolley.speedStep).toBe(5)
		expect(kind.ranged.nativeTiming.fireAt).toBeNear(0.8)
		expect(kind.ranged.nativeTiming.fireInterval).toBe(1)
		expect(C.enemies.Pachyrhinosaurus.projectileVariants.Normal.source).toBe(
			"res://projectiles/slash/slash_projectile_2.tscn"
		)
		expect(C.enemies.Pachyrhinosaurus.evolutionVariantsImplemented).toBe(false)
	end)
end)
