--!strict
-- Complete native starting choices, personal package rules and original unlock challenge in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Streamer")
local Shop = require(f.S.ShopService)
describe("Native Streamer package", function()
	it("runs all36 native starts", function()
		f.starts(36)
	end)
	it("earns stationary interest, changes moving stats immediately and counts equipped structure copies", function()
		f.start("BrassKnuckles")
		Shop.addShards(f.me, 100 - Shop.getShards(f.me))
		f.world.advance(0.1)
		expect(f.Stats.getStat(f.me, "damage")).toBe(-6)
		expect(f.Stats.getStat(f.me, "speed")).toBe(-3)
		assert(f.Stats.addItem(f.me, "BrassSentry"))
		assert(f.Stats.addItem(f.me, "BrassSentry"))
		expect(f.Stats.getStat(f.me, "armor")).toBe(4)
		f.world.advance(1)
		expect(Shop.getShards(f.me)).toBe(103)
		f.world.fireServerAs(f.me, "SetMovementIntent", true)
		expect(f.Stats.getStat(f.me, "damage")).toBe(34)
		expect(f.Stats.getStat(f.me, "attackSpeed")).toBe(40)
		f.world.advance(0.8)
		expect(Shop.getShards(f.me)).toBe(103)
		f.world.fireServerAs(f.me, "SetMovementIntent", false)
		Shop.addShards(f.me, 10000 - Shop.getShards(f.me))
		f.world.advance(1.05)
		expect(Shop.getShards(f.me)).toBe(10025)
		expect(f.Stats.getStat(f.peer, "armor")).toBe(0)
	end)
	it("requires minus20 speed for the personal Slow challenge", function()
		local A = require(f.Shared.Util.CharacterAccess)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Streamer")).toBe(false)
		f.Stats.addStats(f.peer, { speed = -19 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Streamer")).toBe(false)
		f.Stats.addStats(f.peer, { speed = -1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Streamer")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
