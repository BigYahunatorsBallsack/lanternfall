--!strict
-- Native character policies through real combat, stat and weapon services; no mock replacement of the policies.
local world = loadHelper("tests/helpers/RobloxMock.luau")
local Server = game:GetService("ServerScriptService").Server
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
runScript(Server, "init.server.luau")
local S = Server.Services
local Run = require(S.RunDirector)
local Stats = require(S.StatService)
local Combat = require(S.CombatService)
local Weapons = require(S.WeaponService)
local Enemy = require(S.EnemySim)
local Spawn = require(S.SpawnDirector)
local Map = require(S.MapService)
local me = world.addPlayer("Owner", 1, true)
world.advance(0.5)
Spawn.setPaused(true)
Run.setHoldWaves(true)

local function start(id)
	if Run.isOngoing() then
		Run.endRun("Defeat")
	end
	if Run.getPhase() == "Ended" then
		world.advance(Config.Run.flow.resultsSeconds + 0.1)
	end
	-- A test may exercise a native package before its remaining start choices/assets are enabled for users.
	Config.Classes[id].available = true
	require(S.PlayerDataService).unlockAll(me)
	world.fireServerAs(me, "SelectClass", id)
	world.advance(0.3)
	assert(Run.setReady(me, true))
	world.advance(3.5)
	expect(Run.getParticipantClassId(me)).toBe(id)
	Weapons.setPaused(true)
	Enemy.killAll()
end

describe("Native character runtime", function()
	it("updates Golem bonuses at the strict half-HP boundary while blocking healing", function()
		start("Golem")
		expect(Combat.getHp(me)).toBe(39) -- floor((10+20)*1.33), including original initial-stat gain scaling
		Combat.drainPlayer(me, 19)
		expect(Stats.getStat(me, "attackSpeed")).toBe(0)
		Combat.drainPlayer(me, 1)
		expect(Stats.getStat(me, "attackSpeed")).toBe(40)
		expect(Stats.getStat(me, "speed")).toBe(20)
		expect(Combat.healPlayer(me, 10)).toBe(0)
	end)

	it("makes one Lich strike per successful healing call, with no strike at full HP", function()
		start("Lich")
		for _, weapon in Weapons.getWeapons(me) do
			Weapons.removeWeapon(me, weapon.uid)
		end
		local position = Map.getRootPosition(me)
		local id = assert(Enemy.spawn("Brute", position.X + 30, position.Z, 10, 1))
		local before = Enemy.getHealth(id)
		Weapons.setPaused(false)
		Combat.drainPlayer(me, 2)
		expect(Combat.healPlayer(me, 2)).toBe(2)
		world.advance(0.1)
		expect(Enemy.getHealth(id)).toBe(before - 10)
		Combat.healPlayer(me, 100)
		world.advance(0.1)
		expect(Enemy.getHealth(id)).toBe(before - 10)
	end)

	it("applies Sick self-damage once per second through timed hit protection", function()
		start("Sick")
		Combat.protect(me, 10)
		local hp = Combat.getHp(me)
		world.advance(1.05)
		expect(Combat.getHp(me)).toBe(hp - 1)
	end)

	it("keeps Masochist hurt gains until wave end and clears them in the shop", function()
		start("Masochist")
		Combat.drainPlayer(me, 1)
		Combat.drainPlayer(me, 1)
		expect(Stats.getStat(me, "damage")).toBe(-90)
		Run.skipTo(require(game:GetService("ReplicatedStorage").Shared.Util.RunSchedule).wave(Run.getWave()).endsAt)
		expect(Stats.getStat(me, "damage")).toBe(-100)
	end)

	it("switches Soldier bonuses immediately on movement intent, including pushing a wall", function()
		start("Soldier")
		expect(Stats.getStat(me, "damage")).toBe(50)
		world.fireServerAs(me, "SetMovementIntent", true)
		expect(Stats.getStat(me, "damage")).toBe(0)
		expect(Stats.getStat(me, "attackSpeed")).toBe(0)
		world.fireServerAs(me, "SetMovementIntent", false)
		expect(Stats.getStat(me, "damage")).toBe(50)
	end)

	it("grants Farmer harvesting only for consumables collected at full HP", function()
		start("Farmer")
		local Loot = require(S.LootService)
		local value = Stats.getStat(me, "harvesting")
		Loot.ConsumableCollected:Fire(me, "Fruit", false)
		expect(Stats.getStat(me, "harvesting")).toBe(value)
		Loot.ConsumableCollected:Fire(me, "Fruit", true)
		expect(Stats.getStat(me, "harvesting")).toBe(value + 1)
	end)

	it("rounds Vampire's missing-health percentage before linked bonuses", function()
		start("Vampire")
		Stats.addStats(me, { maxHp = 2 })
		Combat.drainPlayer(me, 5)
		expect(Combat.getHp(me)).toBe(4) -- floor((10+2)*0.75)-5
		expect(Stats.getStat(me, "damage")).toBe(52) -- 56% missing HP: -60 +112
		expect(Stats.getStat(me, "lifeSteal")).toBe(18)
	end)

	it("lets Soldier reload while moving and fire as soon as movement stops", function()
		start("Soldier")
		for _, weapon in Weapons.getWeapons(me) do
			Weapons.removeWeapon(me, weapon.uid)
		end
		assert(Weapons.addWeapon(me, "WatchmanPistol"))
		local position = Map.getRootPosition(me)
		-- an egg stands still (a Brute would wander off like Brotato's Bruiser)
		local id = assert(Enemy.spawn("BroodEgg", position.X + 8, position.Z, 100, 1))
		Weapons.setPaused(false)
		world.advance(0.2)
		local afterFirstShot = Enemy.getHealth(id)
		expect(afterFirstShot < Enemy.getMaxHealth(id)).toBe(true)
		world.fireServerAs(me, "SetMovementIntent", true)
		world.advance(1)
		expect(Enemy.getHealth(id)).toBe(afterFirstShot)
		world.fireServerAs(me, "SetMovementIntent", false)
		world.advance(0.2)
		expect(Enemy.getHealth(id) < afterFirstShot).toBe(true)
	end)

	it("resets Streamer's stationary timer even for movement between simulation steps", function()
		start("Streamer")
		local Shop = require(S.ShopService)
		Shop.spendShards(me, Shop.getShards(me))
		world.fireServerAs(me, "SetMovementIntent", true)
		world.fireServerAs(me, "SetMovementIntent", false)
		world.advance(0.7)
		expect(Shop.getShards(me)).toBe(0)
		world.fireServerAs(me, "SetMovementIntent", true)
		world.fireServerAs(me, "SetMovementIntent", false)
		world.advance(0.4)
		expect(Shop.getShards(me)).toBe(0)
		world.advance(0.65)
		expect(Shop.getShards(me)).toBe(1)
	end)
end)
