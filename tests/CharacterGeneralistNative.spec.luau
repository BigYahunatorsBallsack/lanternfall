--!strict
-- Native Generalist atomically adopts its saved id, converts stats without feedback and enforces three slots per kind.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("TwinLedger")
describe("Native Generalist adoption", function()
	it("preserves the saved identity and adopts all27 native starting choices", function()
		expect(f.wasLegacy).toBe(true)
		expect(f.originalName).toBe("Twin Ledger")
		expect(f.originalAvailable).toBe(true)
		expect(f.class.id).toBe("TwinLedger")
		expect(f.class.displayName).toBe("Generalist")
		f.starts(27)
	end)
	it("uses simultaneous unconverted stats and does not leak conversions to a peer", function()
		f.start("RitualDirk")
		assert(f.Stats.addStats(f.me, { rangedDamage = 10, meleeDamage = 4 }))
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(24)
		expect(f.Stats.getStat(f.me, "rangedDamage")).toBe(12)
		f.world.advance(0.5)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(24)
		expect(f.Stats.getStat(f.peer, "rangedDamage")).toBe(0)
	end)
	it("keeps exactly three slots of each kind and unlocks only for the owner's2000 material objects", function()
		f.start("RitualDirk")
		assert(f.Weapons.addWeapon(f.me, "RitualDirk", 1))
		assert(f.Weapons.addWeapon(f.me, "RitualDirk", 1))
		expect(f.Weapons.addWeapon(f.me, "RitualDirk", 1)).toBe(false)
		for _ = 1, 3 do
			assert(f.Weapons.addWeapon(f.me, "WatchmanPistol", 1))
		end
		expect(#f.Weapons.getWeapons(f.me)).toBe(6)
		expect(f.Weapons.addWeapon(f.me, "WatchmanPistol", 1)).toBe(false)
		local Access = require(f.Shared.Util.CharacterAccess)
		f.Data.get(f.peer).nativeCounts.materialsCollected = 1998
		f.Data.observeNativeMaterials(f.peer, 1)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "TwinLedger")).toBe(false)
		f.Data.observeNativeMaterials(f.peer, 1)
		expect(Access.characterUnlocked(f.Data.get(f.peer), "TwinLedger")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
