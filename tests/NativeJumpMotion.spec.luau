--!strict
-- Shared source jump trajectory must match server state without introducing a Roblox Y altitude.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Motion = require(Shared.Util.NativeJumpMotion)
local C = require(Shared.Config.NativeDimetrodon)
describe("Shared native jump motion", function()
	it("holds the preparation position and lands exactly at the captured point", function()
		local x, z, h = Motion.sample(C.jumpRule, -40, 10, 20, 30, 0.4)
		expect(x).toBe(-40)
		expect(z).toBe(10)
		expect(h).toBe(0)
		local lx, lz, lh = Motion.sample(C.jumpRule, -40, 10, 20, 30, 2)
		expect(lx).toBe(20)
		expect(lz).toBe(30)
		expect(lh).toBeNear(0)
	end)
	it("uses the original cubic in/out descent and screen-plane height", function()
		local x, z, h = Motion.sample(C.jumpRule, 0, 0, 80, 40, 0.5 + 1.5 * 0.875)
		local expected = math.sin(0.96875 * math.pi) * 25
		expect(x).toBe(70)
		expect(h).toBeNear(expected)
		expect(z).toBeNear(35 - expected)
	end)
	it("is exactly the trajectory used by the real server jump component", function()
		local Jump = require(game:GetService("ServerScriptService").Server.Services.EnemySim.NativeJump)
		local state = Jump.new(C.jumpRule)
		Jump.step(C.jumpRule, state, 0, -40, 0, 20, 30)
		Jump.step(C.jumpRule, state, 1.3, -40, 0, 99, 99)
		local x, z, h = Motion.sample(C.jumpRule, -40, 0, 20, 30, 1.3)
		expect(state.x).toBeNear(x)
		expect(state.z).toBeNear(z)
		expect(state.height).toBeNear(h)
	end)
end)
