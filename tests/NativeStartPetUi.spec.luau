--!strict
-- Real lobby controllers expose pet selection, server acknowledgements, previews, sync and back navigation.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("BeastMaster")
local Choice = require(folderProxy("src/client", "Client").Controllers.CharacterChoice)
local Pets = require(f.S.StartPetService)
runScript(folderProxy("src/client", "Client"), "init.client.luau")
describe("Native starting pet lobby", function()
	it("shows a pet page for Beast Master while Bull still skips equipment", function()
		expect(Choice.startStep("BeastMaster")).toBe("Pet")
		expect(Choice.startStep("Bull")).toBe("Difficulty")
		f.world.click(f.world.gui("Lobby", "Start"))
		f.world.click(f.world.gui("Lobby", "BeastMaster"))
		f.world.advance(0.1)
		expect(f.Run.getSelectedClassId(f.me)).toBe("BeastMaster")
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Pet Selection")
		expect(f.world.gui("Lobby", "StartingWeapons").Visible).toBe(true)
		expect(f.world.gui("Lobby", "Danger").Visible).toBe(false)
		for _, id in f.class.startPets do
			expect(f.world.gui("Lobby", "Start_" .. id) ~= nil).toBe(true)
		end
		expect(Choice.getStartWeapon()).toBe(nil)
		expect(Choice.getShownPet()).toBe("BonkDog")
	end)
	it("advances only after a valid server acknowledgement and preserves the pick on sync and back", function()
		f.world.fireServerAs(f.me, "SelectStartPet", "BeastMaster", "Ratzilla")
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Pet Selection")
		f.world.click(f.world.gui("Lobby", "Start_CatlingGun"))
		expect(Pets.getStartPet(f.me, "BeastMaster")).toBe("CatlingGun")
		expect(Choice.getStartPet()).toBe("CatlingGun")
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Difficulty Selection")
		f.world.click(f.world.gui("Lobby", "LobbyBack"))
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Pet Selection")
		f.Run.SyncRequested:Fire(f.me)
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Pet Selection")
		expect(Choice.getShownPet()).toBe("CatlingGun")
		f.world.click(f.world.gui("Lobby", "LobbyBack"))
		expect(f.world.gui("Lobby", "PageTitle").Text).toBe("Character Selection")
		expect(#f.world.errors).toBe(0)
	end)
end)
