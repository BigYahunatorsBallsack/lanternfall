--!strict
-- Native character starts, personal source mechanics and exact persistent unlock boundary.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Baby")
local E = require(f.S.ExperienceService)
local function level(player)
	local p = E.getProgress(player)
	assert(E.addXp(p.needed - p.xp, player))
end
describe("Native Baby package", function()
	it("runs all34 native starts", function()
		f.starts(34)
	end)
	it("grants a slot only after choosing its card and switches to normal cards at24slots", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(12)
		expect(f.Stats.getStat(f.me, "itemPrice")).toBe(-20)
		expect(E.getProgress(f.me).needed).toBeNear(36.8)
		expect(f.Weapons.getMaxWeapons(f.me)).toBe(1)
		level(f.me)
		expect(f.Weapons.getMaxWeapons(f.me)).toBe(1)
		f.Run.skipTo(require(f.Shared.Util.RunSchedule).wave(f.Run.getWave()).endsAt)
		f.world.advance(0.1)
		local U = require(f.S.UpgradeService)
		local offer = assert(U.getOffer(f.me))
		expect(#offer).toBe(1)
		expect(offer[1].stat).toBe("weaponSlots")
		f.world.fireServerAs(f.me, "ChooseUpgrade", "forged")
		expect(f.Weapons.getMaxWeapons(f.me)).toBe(1)
		f.world.fireServerAs(f.me, "ChooseUpgrade", offer[1].id)
		expect(f.Weapons.getMaxWeapons(f.me)).toBe(2)
		f.Stats.addStats(f.me, { weaponSlots = 22 })
		expect(f.Weapons.getMaxWeapons(f.me)).toBe(24)
		level(f.me)
		local normal = assert(U.getOffer(f.me))
		expect(#normal).toBe(4)
		for _, card in normal do
			expect(card.stat == "weaponSlots").toBe(false)
		end
		expect(f.Weapons.getMaxWeapons(f.peer)).toBe(6)
	end)
	it("requires personal level10 strictly before wave6", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.start("RitualDirk")
		local schedule = require(f.Shared.Util.RunSchedule)
		f.Run.skipTo(schedule.wave(6).startsAt + 0.1)
		for _ = 1, 10 do
			level(f.peer)
		end
		expect(A.characterUnlocked(f.Data.get(f.peer), "Baby")).toBe(false)
		f.start("RitualDirk")
		for _ = 1, 9 do
			level(f.peer)
		end
		expect(A.characterUnlocked(f.Data.get(f.peer), "Baby")).toBe(false)
		level(f.peer)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Baby")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
