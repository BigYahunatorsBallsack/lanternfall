--!strict
-- Complete native starting choices, personal package rules and original unlock challenge in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Lich")
describe("Native Lich package", function()
	it("runs all29 original starts", function()
		f.starts(29)
	end)
	it("uses original regeneration/lifesteal, damage gain reductions and only actual healing triggers", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "hpRegen")).toBe(10)
		expect(f.Stats.getStat(f.me, "lifeSteal")).toBe(10)
		f.Stats.addStats(f.me, { meleeDamage = 10, damage = 10 })
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(5)
		expect(f.Stats.getStat(f.me, "damage")).toBe(5)
		for _, w in f.Weapons.getWeapons(f.me) do
			f.Weapons.removeWeapon(f.me, w.uid)
		end
		local E = require(f.S.EnemySim)
		local Combat = require(f.S.CombatService)
		local p = f.me.Character.HumanoidRootPart.Position
		local id = assert(E.spawn("Brute", p.X + 30, p.Z, 1000, 0, nil, nil, 0))
		f.Weapons.setPaused(false)
		Combat.drainPlayer(f.me, 1)
		local before = E.getHealth(id)
		Combat.healPlayer(f.me, 1)
		f.world.advance(0.1)
		expect(before - E.getHealth(id)).toBe(11)
		before = E.getHealth(id)
		Combat.healPlayer(f.me, 10)
		f.world.advance(0.1)
		expect(E.getHealth(id)).toBe(before)
	end)
	it("unlocks personally at100 MaxHP", function()
		local A = require(f.Shared.Util.CharacterAccess)
		f.Stats.addStats(f.peer, { maxHp = 118 })
		expect(f.Stats.getStat(f.peer, "maxHp")).toBe(98.5)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Lich")).toBe(false)
		f.Stats.addStats(f.peer, { maxHp = 2 })
		expect(f.Stats.getStat(f.peer, "maxHp")).toBe(100)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Lich")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
