--!strict
-- Native full starting choices, personal core mechanics and exact unlock boundary through production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Entrepreneur")
local Shop = require(f.S.ShopService)
describe("Native Entrepreneur package", function()
	it("runs all31 original starts", function()
		f.starts(31)
	end)
	it("uses original price/gains/recycling and resets only its wallet at wave start", function()
		f.start("RitualDirk")
		expect(f.Stats.getStat(f.me, "itemPrice")).toBe(-25)
		f.Stats.addStats(f.me, { harvesting = 10, meleeDamage = 10, damage = 10 })
		expect(f.Stats.getStat(f.me, "harvesting")).toBe(15)
		expect(f.Stats.getStat(f.me, "meleeDamage")).toBe(5)
		expect(f.Stats.getStat(f.me, "damage")).toBe(5)
		Shop.addShards(f.me, 100)
		Shop.addShards(f.peer, 123 - Shop.getShards(f.peer))
		f.nextWave()
		expect(Shop.getShards(f.me)).toBe(0)
		expect(Shop.getShards(f.peer)).toBe(123)
	end)
	it("requires3000held materials rather than lifetime collection", function()
		local A = require(f.Shared.Util.CharacterAccess)
		Shop.addShards(f.peer, 2999 - Shop.getShards(f.peer))
		expect(A.characterUnlocked(f.Data.get(f.peer), "Entrepreneur")).toBe(false)
		Shop.addShards(f.peer, 1)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Entrepreneur")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
