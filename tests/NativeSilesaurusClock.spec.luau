--!strict
-- Source Silesaurus spawning has no shooting range gate; both later attacks retain separate cold clocks and shared callbacks.
loadHelper("tests/helpers/RobloxMock.luau")
local Shared = game:GetService("ReplicatedStorage").Shared
local Shooting = require(Shared.Util.NativeBossShooting)
local C = require(Shared.Config.NativeSilesaurus)
local function fixed()
	return 0.5
end
describe("Native Silesaurus attack clocks", function()
	it("starts the spawn animation at any distance after sixty frames", function()
		local state = Shooting.new(C.shootingRules, fixed)
		expect(Shooting.physics(state, 1, math.huge)).toBe(true)
		expect(state.animation.speed).toBe(1)
		local fired = Shooting.advanceAnimation(state, 0.8, fixed)
		expect(fired[1]).toBe(1)
		expect(state.animation.playing).toBe(true)
		Shooting.advanceAnimation(state, 0.2, fixed)
		expect(state.clocks[1].remaining).toBe(60)
	end)
	it("initializes child attacks independently instead of inheriting State1 into State2", function()
		local state = Shooting.new(C.shootingRules, fixed)
		expect(state.clocks[2].initial).toBe(0)
		expect(state.clocks[3].initial).toBe(60)
		expect(C.shooting[1].shoot_from_proj_pos_towards_player).toBe(true)
		expect(C.shooting[2].shoot_from_proj_pos_towards_player).toBe(false)
		expect(C.volleys[2].aimFromSpawn).toBe(nil)
		expect(C.volleys[2].baseAimFromSpawn).toBe(true)
	end)
	it("routes an already playing spawn animation into the first child bullet attack", function()
		local state = Shooting.new(C.shootingRules, fixed)
		Shooting.physics(state, 1, math.huge)
		Shooting.select(state, 2)
		local fired = Shooting.advanceAnimation(state, 0.8, fixed)
		expect(fired[1]).toBe(2)
		expect(state.clocks[1].shots).toBe(0)
		expect(state.clocks[2].shots).toBe(1)
		expect(state.clocks[2].remaining).toBe(12)
	end)
end)
