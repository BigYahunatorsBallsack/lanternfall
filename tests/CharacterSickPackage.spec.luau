--!strict
-- Complete native starting choices, personal package rules and original unlock challenge in production services.
local f = loadHelper("tests/helpers/NativeCharacterFixture.luau")("Sick")
describe("Native Sick package", function()
	it("runs all24 starting alternatives", function()
		f.starts(24)
	end)
	it("applies22HP,25LifeSteal and-100Regen, self-damages once a second and resets on retry", function()
		f.start("BrassKnuckles")
		local Combat = require(f.S.CombatService)
		expect(f.Stats.getStat(f.me, "maxHp")).toBe(22)
		expect(f.Stats.getStat(f.me, "lifeSteal")).toBe(25)
		expect(f.Stats.getStat(f.me, "hpRegen")).toBe(-100)
		Combat.protect(f.me, 100)
		local hp = Combat.getHp(f.me)
		f.world.advance(1.05)
		expect(Combat.getHp(f.me)).toBe(hp - 1)
		expect(Combat.getHp(f.peer)).toBe(10)
		f.Run.setParticipantState(f.me, "Down")
		f.Run.setParticipantState(f.peer, "Down")
		f.world.advance(0.1)
		assert(f.Run.retryWave(f.peer))
		expect(Combat.getHp(f.me)).toBe(22)
	end)
	it("unlocks only on reaching negative five regeneration", function()
		local A = require(f.Shared.Util.CharacterAccess)
		expect(A.characterUnlocked(f.Data.get(f.peer), "Sick")).toBe(false)
		f.Stats.addStats(f.peer, { hpRegen = -4 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Sick")).toBe(false)
		f.Stats.addStats(f.peer, { hpRegen = -1 })
		expect(A.characterUnlocked(f.Data.get(f.peer), "Sick")).toBe(true)
		expect(#f.world.errors).toBe(0)
	end)
end)
